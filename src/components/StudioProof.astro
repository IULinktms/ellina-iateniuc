---
import { Image } from 'astro:assets';
import { getHome, hasRealContent } from '../lib/content';
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang; home: Awaited<ReturnType<typeof getHome>> }
const { lang, home } = Astro.props;
const s = t(lang).studio;
const clients = home.clients.filter((item) => hasRealContent(item.name));
const testimonials = home.testimonials.filter((item) => hasRealContent(item.quote) && hasRealContent(item.name));
const stats = home.stats.filter((item) => typeof item.value === 'number' && item.value > 0 && hasRealContent(item.label) && (!item.suffix || hasRealContent(item.suffix)));
const hasProof = clients.length + testimonials.length + stats.length > 0;
---
{hasProof && (
<section class="studio-proof" aria-labelledby="proof-h">
  {stats.length > 0 && <div class="wrap proof-head">
    <span class="small tnum">01 — {s.numbers}</span>
  </div>}
  {stats.length > 0 && <dl class="proof-numbers wrap">
    {stats.map((stat) => <div>
      <dd><span class="display" data-proof-count={stat.value}>{stat.value}</span>{stat.suffix && <span class="small">{stat.suffix}</span>}</dd>
      <dt>{stat.label}</dt>
    </div>)}
  </dl>}
  <div class="proof-heading wrap">
    <h2 class="display" id="proof-h">{s.trust}</h2>
    {clients.length > 1 && <button class="line-link small" data-proof-pause aria-pressed="false">{s.pauseLogos}</button>}
  </div>
  {clients.length > 0 && <div class="proof-logos" data-proof-logos>
    <div class="proof-track">
      {[0,1].map((copy) => <ul role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
        {clients.map((client) => <li>{client.logo ? <Image src={client.logo} alt={client.name} width={220} format="webp" loading="lazy" /> : <span>{client.name}</span>}</li>)}
      </ul>)}
    </div>
  </div>}
  {testimonials.length > 0 && <div class="proof-quotes wrap">
    {testimonials.slice(0,4).map((item) => <figure>
      <blockquote><p>{lang === 'ru' ? '«' : lang === 'ro' ? '„' : '“'}{item.quote}{lang === 'ru' ? '»' : '”'}</p></blockquote>
      <figcaption><strong>{item.name}</strong><span>{[item.role, item.company].filter(hasRealContent).join(' · ')}</span></figcaption>
    </figure>)}
  </div>}
</section>
)}

<style>
  /* Workstream 3: studio proof */
  .studio-proof { padding-block: clamp(4rem,8vw,8rem); background: var(--bone); color: var(--black); overflow: hidden; }
  .proof-head { display:flex;justify-content:space-between;align-items:start;gap:1.5rem; }
  .proof-numbers { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2rem;margin-block:3rem 6rem; }
  .proof-numbers dd { display:flex;flex-direction:column;align-items:start;gap:.6rem; }
  .proof-numbers .display { font-size:clamp(3.5rem,7vw,7rem);font-variant-numeric:tabular-nums; }
  .proof-numbers dt { margin-top:.75rem;font-size:.9rem;color:#514d46; }
  .proof-heading { display:flex;align-items:end;justify-content:space-between;gap:2rem; }
  .proof-heading h2 { font-size:clamp(2.5rem,5vw,5rem);max-width:20ch;text-wrap:balance; }
  .proof-heading button { flex-shrink:0; }
  .proof-logos { margin-block:3rem 5rem;border-block:1px solid rgb(0 0 0 / .18); }
  .proof-track { display:flex;width:max-content;animation:proof-drift 32s linear infinite; }
  .proof-track ul { display:flex;align-items:center;flex:none;gap:clamp(3rem,6vw,7rem);padding:2rem 3rem; }
  .proof-track li { font-family:var(--serif);font-size:clamp(1.4rem,2vw,2rem);white-space:nowrap; }
  .proof-track img { max-width:10rem;max-height:3rem;object-fit:contain;filter:grayscale(1); }
  .proof-logos:hover .proof-track,.proof-logos.is-paused .proof-track { animation-play-state:paused; }
  .proof-quotes { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4rem; }
  .proof-quotes figure { border-top:1px solid rgb(0 0 0 / .25);padding-top:2rem; }
  blockquote { font-family:var(--serif);font-size:clamp(1.5rem,2.5vw,2.5rem);line-height:1.2; }
  figcaption { display:grid;gap:.25rem;margin-top:2rem;font-size:.85rem; }
  figcaption strong { font-weight:500; } figcaption span { color:#514d46; }
  @keyframes proof-drift { to { transform:translateX(-50%); } }
  @media(max-width:760px) { .proof-head,.proof-heading{flex-direction:column;align-items:start}.proof-numbers{grid-template-columns:1fr 1fr;margin-bottom:4rem}.proof-quotes{grid-template-columns:1fr;gap:3rem} }
  @media(prefers-reduced-motion:reduce) { .proof-track{animation:none}.proof-track ul[aria-hidden]{display:none}.proof-track,.proof-track ul{width:100%;flex-wrap:wrap}.proof-heading button{display:none} }
</style>
