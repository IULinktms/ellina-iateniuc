---
/** "Out of frame": the 404 page body, in the visitor's language. */
import Base from '../layouts/Base.astro';
import { localePath, t, type Lang } from '../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const s = t(lang).notFound;
---

<Base page="404" lang={lang} title={s.title} noindex>
  <section class="notfound">
    <h1 class="display" data-split="now">{s.h}</h1>
    <p class="muted">{s.text}</p>
    <div class="cta__actions" style="justify-content:center;margin:0">
      <a class="btn btn--solid" href={localePath(lang, '/portfolio/')}>{s.portfolio}</a>
      <a class="btn" href={localePath(lang, '/')}>{s.home}</a>
    </div>
  </section>
</Base>
