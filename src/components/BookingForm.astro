---
import { getBooking, getSite } from '../lib/content';
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang; booking: Awaited<ReturnType<typeof getBooking>>; site: Awaited<ReturnType<typeof getSite>> }
const { lang, booking, site } = Astro.props;
const c = t(lang).contact;
const ui = t(lang).bookingUi;
const types = [...booking.sessions.map((x) => x.name), c.other];
const isPreview = import.meta.env.PUBLIC_PREVIEW_LITE === '1';
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---
<!-- Workstream 4: all fields remain available without JS; enhancement shows one step at a time. -->
<form action="/api/contact" method="post" data-contact novalidate data-preview={isPreview ? '' : undefined}>
  <input type="hidden" name="lang" value={lang} />
  <ol class="booking-steps" data-step-nav hidden aria-label={c.submit}>
    {ui.steps.map((label, i) => <li><button type="button" data-step-go={i} aria-controls={`booking-step-${i}`}><span class="tnum">0{i+1}</span>{label}</button></li>)}
  </ol>
  <p class="sr-only" data-step-status role="status"></p>
  <fieldset class="booking-step" data-booking-step id="booking-step-0" tabindex="-1">
    <legend class="booking-step__title">{c.kind}</legend>
    <div class="chips">
      {types.map((x, i) => <><input type="radio" name="type" id={`t-${i}`} value={x} checked={i===0} /><label for={`t-${i}`}>{x}</label></>)}
    </div>
  </fieldset>
  <fieldset class="booking-step" data-booking-step id="booking-step-1" tabindex="-1">
    <legend class="booking-step__title">{c.date}</legend>
    <div class="field">
      <label for="f-date">{c.date}</label>
      <input id="f-date" name="date" type="date" data-date-input lang={lang} aria-describedby="date-note date-error" />
      <span class="err" id="date-error" aria-live="polite"></span>
    </div>
    <p class="date-hint" data-date-hint data-preview={site.delivery.previewTime} data-gallery={site.delivery.galleryDays} data-film={site.delivery.filmDays} aria-live="polite">{c.hint(site.delivery.previewTime,site.delivery.galleryDays)}</p>
    <p class="small muted" id="date-note">{ui.dateOptional}</p>
  </fieldset>
  <fieldset class="booking-step" data-booking-step id="booking-step-2" tabindex="-1">
    <legend class="booking-step__title">{c.message}</legend>
    <div class="field-row">
      <div class="field"><label for="f-org">{c.org}</label><input id="f-org" name="organisation" autocomplete="organization" maxlength="160" /><span class="err"></span></div>
      <div class="field"><label for="f-guests">{c.guests}</label><input id="f-guests" name="guests" inputmode="numeric" placeholder={c.guestsPh} maxlength="20" /><span class="err"></span></div>
    </div>
    <div class="field"><label for="f-loc">{c.location}</label><input id="f-loc" name="location" placeholder={c.locationPh} maxlength="160" /><span class="err"></span></div>
    <div class="field"><label for="f-msg">{c.message}</label><textarea id="f-msg" name="message" required maxlength="5000" placeholder={c.messagePh} aria-describedby="message-error"></textarea><span class="err" id="message-error" aria-live="polite"></span></div>
  </fieldset>
  <fieldset class="booking-step" data-booking-step id="booking-step-3" tabindex="-1">
    <legend class="booking-step__title">{ui.steps[3]}</legend>
    <div class="field-row">
      <div class="field"><label for="f-name">{c.name}</label><input id="f-name" name="name" autocomplete="name" required maxlength="120" aria-describedby="name-error" /><span class="err" id="name-error" aria-live="polite"></span></div>
      <div class="field"><label for="f-email">{c.email}</label><input id="f-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="email-error" /><span class="err" id="email-error" aria-live="polite"></span></div>
    </div>
    {turnstileKey && <>
      <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="dark" data-language={lang} style="margin-top:1.5rem"></div>
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    </>}
  </fieldset>
  <!-- Original spam fields and API contract retained. -->
  <div class="hp" aria-hidden="true"><label for="f-website">Website</label><input id="f-website" name="website_url" tabindex="-1" autocomplete="off" /></div>
  <input type="hidden" name="_t" value="" />
  <div class="booking-controls" data-step-controls hidden>
    <button class="line-link" type="button" data-step-back>{ui.back}</button>
    <button class="btn btn--solid" type="button" data-step-next>{ui.continue}<span aria-hidden="true">→</span></button>
  </div>
  <div class="form-foot" data-form-foot>
    <p class="form-status" data-status role="status" aria-live="polite">{site.responseTime}</p>
    <button class="btn btn--solid" type="submit">{c.submit}</button>
  </div>
</form>
<div class="form-done booking-done" data-form-done hidden tabindex="-1">
  <p>{booking.successMessage}</p>
  {booking.successSteps.length > 0 && <section aria-labelledby="success-next"><h2 id="success-next">{ui.nextSteps}</h2><ol>{booking.successSteps.map((step) => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></section>}
</div>
<style>
  /* Workstream 4: calm progressive booking, full form when scripting is unavailable. */
  .booking-step { border:0;margin:0 0 2rem;padding:0;min-width:0; }
  .booking-step__title { font-family:var(--serif);font-size:clamp(1.65rem,3vw,2.8rem);line-height:1.1;margin-bottom:1.5rem;padding:0; }
  .booking-steps { list-style:none;padding:0;margin:0 0 3rem;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem; }
  .booking-steps[hidden],.booking-controls[hidden],.booking-step[hidden] { display:none; }
  .booking-steps button { display:flex;flex-direction:column;gap:.5rem;align-items:start;width:100%;padding-block:.75rem;border-top:1px solid var(--line-strong);font-size:.8rem;color:var(--ash); }
  .booking-steps button[aria-current] { color:var(--bone);border-color:var(--projector); }
  .booking-steps span { font-size:.7rem;letter-spacing:.08em; }
  .booking-controls { display:flex;justify-content:space-between;align-items:center;margin-top:2rem;gap:1rem; }
  .booking-step .chips label { height:auto;min-height:2.75rem;padding-block:.55rem;line-height:1.3; }
  .booking-step .chips { gap:.65rem; }
  .booking-done section { margin-top:3rem; }
  .booking-done h2 { font-size:1rem;font-weight:500; }
  .booking-done ol { list-style:none;counter-reset:next;padding:0;display:grid;gap:1.75rem;margin-top:1.75rem; }
  .booking-done li { counter-increment:next;padding-left:2.5rem;position:relative; }
  .booking-done li::before { content:'0' counter(next);position:absolute;left:0;top:0;color:var(--projector);font-size:.8rem; }
  .booking-done h3 { font-family:var(--serif);font-size:1.5rem;font-weight:400; }
  .booking-done section p { font-family:var(--sans);font-size:1rem;letter-spacing:0;line-height:1.55;max-width:34rem;margin-top:.4rem;color:var(--bone-dim); }
</style>
