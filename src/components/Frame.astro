---
/**
 * A responsive photograph inside an "aperture" frame.
 * aperture: opens from a thin horizontal slit when scrolled into view.
 * parallax: the image drifts slightly slower than the page.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { lqip, withLqip } from '../lib/lqip';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  class?: string;
  aperture?: boolean;
  parallax?: boolean;
  eager?: boolean;
  widths?: number[];
  quality?: number;
  style?: string;
  [key: string]: unknown;
}
const {
  src,
  alt,
  sizes = '100vw',
  class: cls = '',
  aperture = true,
  parallax = false,
  eager = false,
  widths,
  quality = 75,
  style,
  ...rest
} = Astro.props;

// Lightweight variant set for the hosted static preview only
const lite = import.meta.env.PUBLIC_PREVIEW_LITE === '1';
// Capped at 1600px: wider WebPs of busy event photos run 0.5–1 MB for little visible gain
const ws = (lite ? [1400] : widths ?? [480, 800, 1200, 1600]).filter((w) => w <= src.width);
if (!ws.length) ws.push(src.width);
// Blurred preview painted with the HTML; lazy images crossfade over it once decoded
const placeholder = await lqip(src);
---

<div
  class:list={['frame', cls]}
  data-aperture={aperture ? '' : undefined}
  data-parallax={parallax ? '' : undefined}
  data-lqip={placeholder ? (eager ? 'eager' : '') : undefined}
  style={withLqip(placeholder, style)}
  {...placeholder?.attrs}
  {...rest}
>
  <Image
    src={src}
    alt={alt}
    widths={ws}
    width={Math.max(...ws)}
    sizes={sizes}
    format="webp"
    quality={quality}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
  <slot />
</div>
