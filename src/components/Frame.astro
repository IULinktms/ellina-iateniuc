---
/**
 * A responsive photograph inside an "aperture" frame.
 * aperture: opens from a thin horizontal slit when scrolled into view.
 * parallax: the image drifts slightly slower than the page.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { lqip, withLqip } from '../lib/lqip';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  class?: string;
  aperture?: boolean;
  parallax?: boolean;
  eager?: boolean;
  widths?: number[];
  quality?: number;
  style?: string;
  [key: string]: unknown;
}
const {
  src,
  alt,
  sizes = '100vw',
  class: cls = '',
  aperture = true,
  parallax = false,
  eager = false,
  widths,
  quality = 75,
  style,
  ...rest
} = Astro.props;

// Lightweight variant set for the hosted static preview only
const lite = import.meta.env.PUBLIC_PREVIEW_LITE === '1';
// Capped at 1600px: wider WebPs of busy event photos run 0.5–1 MB for little visible gain
const ws = (lite ? [1400] : widths ?? [480, 800, 1200, 1600]).filter((w) => w <= src.width);
if (!ws.length) ws.push(src.width);
// Blurred preview painted with the HTML; lazy images crossfade over it once decoded
const placeholder = await lqip(src);
const img = await getImage({ src, widths: ws, width: Math.max(...ws), sizes, format: 'webp', quality });
const { width, height } = img.attributes;
---

<div
  class:list={['frame', cls]}
  data-aperture={aperture ? '' : undefined}
  data-parallax={parallax ? '' : undefined}
  data-lqip={placeholder ? (eager ? 'eager' : '') : undefined}
  style={withLqip(placeholder, style)}
  {...placeholder?.attrs}
  {...rest}
>
  {eager ? (
    <img src={img.src} srcset={img.srcSet.attribute} sizes={sizes} alt={alt} width={width} height={height} loading="eager" fetchpriority="high" decoding="async" />
  ) : (
    <>
      {/* Lazy photos get their srcset two frames after the first paint (Base.astro), so even the ones near
          the fold never compete with the opening text for bandwidth. Without JS the <noscript> copy loads. */}
      <img data-defer-src={img.src} data-defer-srcset={img.srcSet.attribute} sizes={sizes} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
      <noscript><img src={img.src} srcset={img.srcSet.attribute} sizes={sizes} alt={alt} width={width} height={height} loading="lazy" decoding="async" /></noscript>
    </>
  )}
  <slot />
</div>
