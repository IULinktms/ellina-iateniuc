---
/**
 * The live element: pick an event date and see when each deliverable arrives.
 * Works without JavaScript (shows the plain promises); script fills in real dates.
 */
interface Props {
  previewTime: string;
  galleryDays: number;
  filmDays: number;
  id?: string;
}
const { previewTime, galleryDays, filmDays, id = 'calc' } = Astro.props;
---

<div class="calc" data-calc data-preview={previewTime} data-gallery={galleryDays} data-film={filmDays}>
  <div class="calc__field">
    <label for={`${id}-date`}>Your event date</label>
    <input type="date" id={`${id}-date`} data-calc-input />
  </div>
  <dl class="calc__out" aria-live="polite">
    <div>
      <dt>Edited previews</dt>
      <dd data-calc-preview>The same evening, {previewTime}</dd>
    </div>
    <div>
      <dt>Full gallery</dt>
      <dd data-calc-gallery>Within {galleryDays} working days</dd>
    </div>
    <div>
      <dt>Aftermovie</dt>
      <dd data-calc-film>Within {filmDays} working days</dd>
    </div>
  </dl>
  <a class="btn btn--solid calc__cta" href="/contact/" data-calc-cta>Check this date</a>
</div>
