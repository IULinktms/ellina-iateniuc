---
/**
 * Contact sheet: one frame fills the screen, then scroll pulls back to reveal it is
 * a single exposure on a full sheet. A grease-pencil circle marks the select.
 * Frames come from project galleries automatically, so it stays current from /admin.
 */
import { Image } from 'astro:assets';
import { getProjects, getHome, projectPhotos } from '../lib/content';
import { t, type Lang } from '../lib/i18n';
import { lqip } from '../lib/lqip';

const { lang } = Astro.props as { lang: Lang };
const tx = t(lang);

const projects = await getProjects(lang);
// With fewer than 15 frames in total the sheet stays hidden (see below)
const pool = projects.flatMap((p) => projectPhotos(p).map((f) => ({ src: f.src, alt: f.alt, project: p.data.title })));
// Interleave projects so neighbouring frames differ
const groups = new Map<string, typeof pool>();
for (const f of pool) groups.set(f.project, [...(groups.get(f.project) ?? []), f]);
const byProject = [...groups.values()];
const frames: typeof pool = [];
for (let i = 0; frames.length < 15 && byProject.some((g) => g[i]); i++) {
  for (const g of byProject) if (g[i] && frames.length < 15) frames.push(g[i]);
}
const home = await getHome(lang);
// The opening exposure is the same still as the home hero, then pulls back into the sheet.
if (frames[7]) frames[7] = { src: home.sheetPoster ?? home.heroPoster, alt: home.sheetPosterAlt ?? home.heroPosterAlt, project: "" };
const placeholders = await Promise.all(frames.map((f) => lqip(f.src)));
const HERO = 7; // centre of a 5 x 3 sheet
const SELECT = 3;
const roll = 14;
---

{frames.length >= 15 && (
  <section class="sheet" data-sheet aria-labelledby="sheet-h">
    <div class="sheet__stage">
      <div class="sheet__grid" data-sheet-grid>
        {frames.map((f, i) => (
          <figure class:list={['sheet__cell', i === HERO && 'is-hero', i === SELECT && 'is-select']} data-sheet-cell={i}>
            <div class="sheet__img" data-lqip={placeholders[i] ? '' : undefined} style={placeholders[i]?.style} {...placeholders[i]?.attrs}>
              {/* Phones never scale the sheet to cover, so the hero cell stays a third of the screen there */}
              <Image
                src={f.src}
                alt={i === HERO ? f.alt : ''}
                widths={i === HERO ? [480, 960, 1600, 2400, 3200] : [360, 640, 960]}
                sizes={i === HERO ? '(max-width: 760px) 34vw, 100vw' : '(max-width: 760px) 33vw, 20vw'}
                format="webp"
                quality={i === HERO ? 85 : 80}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="sheet__num tnum" aria-hidden="true">{roll}{String.fromCharCode(65 + (i % 3))} · {String(i + 1).padStart(2, '0')}</figcaption>
            {i === SELECT && (
              <svg class="sheet__mark" viewBox="0 0 120 90" preserveAspectRatio="none" aria-hidden="true">
                <path pathLength="1" d="M60 6 C 98 4, 116 22, 114 46 C 112 72, 86 86, 56 84 C 24 82, 5 66, 7 42 C 9 18, 34 6, 66 9" />
              </svg>
            )}
          </figure>
        ))}
      </div>
      <div class="sheet__copy" data-sheet-copy>
        <p class="sheet__kicker tnum">{tx.home.sheetKicker(roll, String(SELECT + 1).padStart(2, '0'))}</p>
        <h2 id="sheet-h" class="display sheet__title">{tx.home.sheetA} <em>{tx.home.sheetB}</em></h2>
      </div>
    </div>
  </section>
)}
