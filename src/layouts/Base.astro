---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import { getSite, shareImage } from '../lib/content';
import { LOCALES, LANG_NAMES, LANG_SHORT, HTML_LANG, OG_LOCALE, DEFAULT_LANG, localePath, splitPath, t, clientStrings, type Lang } from '../lib/i18n';
import Icon from '../components/Icon.astro';
import DirectContact from '../components/DirectContact.astro';
import fontLatin from '../assets/fonts/inter-tight-latin.woff2?url';
import fontCyrillic from '../assets/fonts/inter-tight-cyrillic.woff2?url';
import { serviceLd, breadcrumbLd } from '../lib/seo';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  page: string;
  noindex?: boolean;
}
const { lang, title, description, image, imageAlt, type = 'website', jsonLd, page, noindex = false } = Astro.props;
const s = t(lang);
const site = await getSite(lang);
const fullTitle = title ? `${title} — ${site.name}` : site.seoTitle;
const desc = description ?? site.seoDescription;
const { rest } = splitPath(Astro.url.pathname);
const canonical = new URL(localePath(lang, rest), Astro.site);
const alternates = LOCALES.map((l) => ({ lang: l, href: new URL(localePath(l, rest), Astro.site).toString() }));
// Share image: branded card for projects and for pages without a photo of their own (src/pages/og/)
const workSlug = page === 'work' ? rest.match(/^\/work\/([^/]+)/)?.[1] : undefined;
const ogCard = workSlug ? `/og/${lang}/${workSlug}.jpg` : !image ? `/og/${lang}/site.jpg` : undefined;
const og = new URL(ogCard ?? (await shareImage(image!)), Astro.site);
const L = (p: string) => localePath(lang, p);

const nav = [
  { href: L('/portfolio/'), label: s.nav.portfolio, key: 'portfolio' },
  { href: L('/films/'), label: s.nav.films, key: 'films' },
  { href: L('/about/'), label: s.nav.about, key: 'about' },
  { href: L('/contact/'), label: s.nav.book, key: 'contact' },
];
const crumbs = page === 'home' || page === '404' ? [] : [
  { name: s.nav.home, url: new URL(L('/'), Astro.site).toString() },
  ...(page === 'work' ? [{ name: s.nav.portfolio, url: new URL(L('/portfolio/'), Astro.site).toString() }] : []),
  { name: title ?? site.name, url: canonical.toString() },
];
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    serviceLd(site, lang, Astro.site!, new URL(L('/'), Astro.site).toString(), new URL(`/og/${lang}/site.jpg`, Astro.site).toString()),
    ...(crumbs.length ? [breadcrumbLd(crumbs)] : []),
    ...(jsonLd ? [jsonLd].flat() : []),
  ],
};
const year = new Date().getFullYear();
// Page change: the frame closes to a slit of light, then opens on the next page (≈0.58 s; off for reduced motion)
const apertureSwap = {
  old: { name: 'aperture-close', duration: '0.22s', easing: 'cubic-bezier(0.77, 0, 0.175, 1)', fillMode: 'both' },
  new: { name: 'aperture-open', duration: '0.36s', delay: '0.2s', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'both' },
};
const aperture = { forwards: apertureSwap, backwards: apertureSwap };
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={HTML_LANG[a.lang]} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.lang === DEFAULT_LANG)!.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" as="font" type="font/woff2" href={fontLatin} crossorigin />
    {lang === 'ru' && <link rel="preload" as="font" type="font/woff2" href={fontCyrillic} crossorigin />}
    <slot name="head" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LOCALES.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    {ogCard && <meta property="og:image:width" content="1200" />}
    {ogCard && <meta property="og:image:height" content="630" />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={og} />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter fallback="swap" />
  </head>
  <body data-page={page} data-lang={lang}>
    <script type="application/json" id="i18n" set:html={JSON.stringify(clientStrings(lang))} />
    <a class="skip-link" href="#main">{s.skip}</a>

    <header class="nav" transition:persist={`nav-${lang}`}>
      <a href={L('/')} class="nav__mark" aria-label={`${site.name}, ${s.nav.home}`}>Ellina <span>Yatsenyuk</span></a>
      <nav aria-label={s.nav.main} class="nav__right">
        <ul class="nav__links" role="list">
          {nav.map((n) => (
            <li>
              <a class:list={[n.key === 'contact' ? 'nav__cta' : 'line-link']} href={n.href} data-nav={n.key} aria-current={page === n.key ? 'page' : undefined}>{n.label}</a>
            </li>
          ))}
        </ul>
        <ul class="lang" role="list" aria-label={s.nav.language}>
          {LOCALES.map((l) => (
            <li>
              <a href={localePath(l, rest)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} title={LANG_NAMES[l]} aria-current={l === lang ? 'true' : undefined} data-astro-reload>{LANG_SHORT[l]}</a>
            </li>
          ))}
        </ul>
      </nav>
      <button class="nav__toggle" aria-expanded="false" aria-controls="menu" data-menu-toggle>{s.nav.menu}</button>
      <a class="nav__nojs" href="#menu">{s.nav.menu}</a>
    </header>

    <div class="menu" id="menu" data-lenis-prevent transition:persist={`menu-${lang}`}>
      <ul class="menu__list" role="list">
        <li><a href={L('/')} data-nav="home">{s.nav.home}</a></li>
        {nav.map((n) => <li><a href={n.href} data-nav={n.key}>{n.label}</a></li>)}
      </ul>
      <div class="menu__foot">
        <ul class="lang lang--menu" role="list" aria-label={s.nav.language}>
          {LOCALES.map((l) => (
            <li><a href={localePath(l, rest)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} aria-current={l === lang ? 'true' : undefined} data-astro-reload>{LANG_NAMES[l]}</a></li>
          ))}
        </ul>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <DirectContact lang={lang} site={site} />
        <span>{site.socials.filter((x) => x.label !== 'Telegram').map((x, i) => <>{i > 0 && ', '}<a href={x.url} rel="me noopener" target="_blank">{x.label}</a></>)}</span>
      </div>
    </div>

    <main id="main" transition:animate={aperture}>
      <slot />
    </main>

    {page !== '404' && (
      <footer class="footer">
        <div class="footer__grid">
          <div>
            <p class="muted">{site.role}, {site.location}.</p>
            <p style="margin-top:.4rem"><a class="line-link" href={`mailto:${site.email}`}>{site.email}</a></p>
            <DirectContact lang={lang} site={site} />
          </div>
          <div>
            <h2>{s.footer.pages}</h2>
            <ul role="list">
              {nav.map((n) => <li><a class="line-link" href={n.href}>{n.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>{s.footer.elsewhere}</h2>
            <ul role="list">
              {site.socials.filter((x) => x.label !== 'Telegram').map((x) => <li><a class="line-link" href={x.url} rel="me noopener" target="_blank">{x.label}</a></li>)}
            </ul>
          </div>
        </div>
        <p class="footer__big" aria-hidden="true">Ellina <span>Yatsenyuk</span></p>
        <div class="footer__legal">
          <span>© {year} {site.name}. {s.footer.rights}</span>
          <a href="#main" class="line-link" data-to-top>{s.footer.toTop}</a>
        </div>
      </footer>
    )}

    <!-- Workstream 4: booking remains one tap away after the opening frame. -->
    {page !== 'contact' && page !== '404' && <aside class="mobile-booking" data-mobile-booking hidden>
      <span class="small">{site.name}</span><a href={L('/contact/')} class="btn btn--solid">{s.studio.book}<span aria-hidden="true">↗</span></a>
    </aside>}

    <!-- Film grain over everything (decorative) -->
    <div class="grain" aria-hidden="true" transition:persist="grain"></div>

    <!-- Viewfinder cursor (decorative) -->
    <div class="cursor is-hidden" aria-hidden="true" transition:persist="cursor">
      <div class="cursor__ring"><i></i><i></i><i></i><i></i></div>
      <div class="cursor__dot"></div>
      <div class="cursor__label"></div>
    </div>

    <!-- Full-screen photo viewer -->
    <dialog class="lightbox" aria-label={s.viewer.photo} data-lightbox transition:persist={`lightbox-${lang}`}>
      <div class="lightbox__bar">
        <span class="tnum" data-lb-count></span>
        <button class="line-link small" data-lb-zoom aria-pressed="false">{s.studio.zoom}</button>
        <button class="icon-btn" data-lb-close aria-label={s.viewer.close}><Icon name="close" /></button>
      </div>
      <div class="lightbox__stage">
        <img alt="" data-lb-img />
        <p class="lightbox__status small" data-lb-status role="status"></p>
        <button class="lightbox__prev-zone" data-lb-prev tabindex="-1" aria-hidden="true"></button>
        <button class="lightbox__next-zone" data-lb-next tabindex="-1" aria-hidden="true"></button>
      </div>
      <div class="lightbox__foot">
        <p data-lb-caption></p>
        <div class="lightbox__nav">
          <a class="line-link" data-lb-project href="#" hidden>{s.viewer.project}</a>
          <button class="icon-btn" data-lb-prev aria-label={s.viewer.prev}><Icon name="prev" /></button>
          <button class="icon-btn" data-lb-next aria-label={s.viewer.next}><Icon name="next" /></button>
        </div>
      </div>
    </dialog>

    <!-- Film player -->
    <dialog class="player" aria-label={s.viewer.film} data-player transition:persist={`player-${lang}`}>
      <div class="lightbox__bar">
        <span data-player-title></span>
        <button class="icon-btn" data-player-close aria-label={s.viewer.closeFilm}><Icon name="close" /></button>
      </div>
      <div class="player__stage" data-player-stage></div>
    </dialog>

    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
