---
/**
 * Unlisted client gallery: /g/<slug>/ for every manifest in src/data/client-galleries/.
 * A standalone page, separate from the portfolio site (no site nav, footer or motion), styled for the
 * client's event (Casmara: ivory, ink, a fine serif). Kept out of search (robots meta here, X-Robots-Tag
 * in scripts/headers.mjs) and out of the sitemap; linked from no page.
 * Grid thumbnails come from src/assets/galleries/<id>/; the viewer and downloads use the untouched
 * full-size originals in Vercel Blob, so nothing the guests see or save is re-compressed.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Photo { name: string; url: string; width: number; height: number; bytes: number; }
interface Gallery {
  id: string; slug: string; title: string; subtitle: string; credit: string;
  zip: { name: string; url: string; bytes: number };
  photos: Photo[];
}

export function getStaticPaths() {
  const manifests = import.meta.glob<Gallery>('../../data/client-galleries/*.json', { eager: true, import: 'default' });
  return Object.values(manifests).map((gallery) => ({ params: { gallery: gallery.slug }, props: { gallery } }));
}

const { gallery } = Astro.props as { gallery: Gallery };
const sources = import.meta.glob<ImageMetadata>('../../assets/galleries/*/*.jpg', { eager: true, import: 'default' });
const photos = await Promise.all(
  gallery.photos.map(async (p, i) => {
    const src = sources[`../../assets/galleries/${gallery.id}/${p.name}`];
    if (!src) throw new Error(`Gallery ${gallery.id}: missing web-size file for ${p.name}`);
    const small = await getImage({ src, width: Math.min(600, src.width), format: 'webp', quality: 82 });
    const medium = await getImage({ src, width: Math.min(1200, src.width), format: 'webp', quality: 85 });
    return {
      ...p,
      number: String(i + 1).padStart(3, '0'),
      thumb: small.src,
      mid: medium.src,
      srcset: `${small.src} ${small.attributes.width ?? 600}w, ${medium.src} ${medium.attributes.width ?? 1200}w`,
      ratio: p.width / p.height,
    };
  }),
);
const download = (url: string) => `${url}?download=1`;
const mb = (bytes: number) => `${new Intl.NumberFormat('ru-RU', { maximumFractionDigits: bytes < 1e8 ? 1 : 0 }).format(bytes / 1e6)} МБ`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <title>{gallery.title} — фотографии</title>
  <meta name="description" content={`${gallery.title}: все фотографии с мероприятия.`} />
  <meta property="og:title" content={gallery.title} />
  <meta property="og:description" content={`${photos.length} фотографий · ${gallery.subtitle}`} />
  <meta property="og:image" content={new URL(photos[0].thumb, Astro.site).toString()} />
  <meta name="theme-color" content="#f6f2ec" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="head">
    <p class="eyebrow">Casmara Moldova</p>
    <h1>{gallery.title}</h1>
    <p class="sub">{gallery.subtitle}</p>
    <div class="rule" aria-hidden="true"></div>
    <p class="count">{photos.length} фотографий · {photos.length} fotografii</p>
    <a class="btn" href={download(gallery.zip.url)} download={gallery.zip.name}>
      <span>Скачать все фото</span><span class="ro">Descărcați toate fotografiile</span>
    </a>
    <p class="note">ZIP · оригиналы в полном качестве · {mb(gallery.zip.bytes)}<br /><span class="ro-note">Originale la calitate maximă. O singură fotografie — butonul de sub ea.</span></p>
  </header>

  <main class="grid" aria-label="Фотографии">
    {photos.map((p, i) => (
      <figure class:list={['item', p.ratio > 1.15 && 'wide']}>
        <button type="button" class="open" data-i={i} aria-label={`Открыть фото ${p.number}`}>
          <img src={p.thumb} srcset={p.srcset} sizes={p.ratio > 1.15 ? '(max-width: 700px) 100vw, 50vw' : '(max-width: 700px) 50vw, (max-width: 1200px) 33vw, 25vw'} alt={`${gallery.title}, фото ${p.number}`} width={p.width} height={p.height} loading={i < 6 ? 'eager' : 'lazy'} decoding="async" />
        </button>
        <figcaption>
          <span>{p.number}</span>
          <a href={download(p.url)} download={p.name} aria-label={`Скачать фото ${p.number}, ${mb(p.bytes)}`}>Скачать · {mb(p.bytes)}</a>
        </figcaption>
      </figure>
    ))}
  </main>

  <footer class="foot">
    <a class="btn" href={download(gallery.zip.url)} download={gallery.zip.name}>
      <span>Скачать все фото</span><span class="ro">Descărcați toate fotografiile</span>
    </a>
    <p class="credit">Фото · Fotografii: <a href="https://ellinayatsenyuk.com/" target="_blank" rel="noopener">Эллина Яценюк / Ellina Yatsenyuk</a> © {year}</p>
  </footer>

  <dialog class="viewer" aria-label="Просмотр фото">
    <div class="vbar">
      <span class="vcount" aria-live="polite"></span>
      <a class="vdl" href="#" download>Скачать оригинал</a>
      <button type="button" class="vclose" aria-label="Закрыть">✕</button>
    </div>
    <button type="button" class="vprev" aria-label="Предыдущее">‹</button>
    <img class="vimg" alt="" />
    <button type="button" class="vnext" aria-label="Следующее">›</button>
  </dialog>

  <script type="application/json" id="photos" set:html={JSON.stringify(photos.map((p) => ({ n: p.number, preview: p.mid, full: `/gallery/${gallery.id}/${p.number}.webp`, dl: download(p.url), name: p.name })))} />
  <script>
    const data: { n: string; preview: string; full: string; dl: string; name: string }[] = JSON.parse(document.getElementById('photos')!.textContent || '[]');
    const dlg = document.querySelector<HTMLDialogElement>('.viewer')!;
    const img = dlg.querySelector<HTMLImageElement>('.vimg')!;
    const count = dlg.querySelector<HTMLElement>('.vcount')!;
    const dl = dlg.querySelector<HTMLAnchorElement>('.vdl')!;
    let cur = 0;
    const hq = new Map<string, boolean>();
    const pending = new Map<string, Promise<void>>();
    const load = (url: string) => {
      if (hq.get(url)) return Promise.resolve();
      if (!pending.has(url)) pending.set(url, new Promise<void>((res) => {
        const im = new Image();
        im.onload = () => { hq.set(url, true); im.decode?.().catch(() => {}).finally(() => res()) ?? res(); };
        im.onerror = () => res();
        im.src = url;
      }));
      return pending.get(url)!;
    };
    const show = (i: number) => {
      cur = (i + data.length) % data.length;
      const p = data[cur];
      // Large viewer image (2560px, visually lossless). Until it arrives, the grid preview holds the
      // place with a thin progress line — never a blurred frame. Downloads stay the untouched original.
      const ready = hq.get(p.full);
      if (ready) { img.src = p.full; img.classList.remove('loading'); }
      else {
        img.src = p.preview; img.classList.add('loading');
        load(p.full).then(() => { if (data[cur] === p) { img.src = p.full; img.classList.remove('loading'); } });
      }
      count.textContent = `${p.n} / ${data.length}`;
      dl.href = p.dl; dl.setAttribute('download', p.name);
      // Fetch the neighbours ahead so swiping is instant
      [cur + 1, cur - 1, cur + 2].forEach((j) => load(data[(j + data.length) % data.length].full));
    };
    document.querySelectorAll<HTMLButtonElement>('.open').forEach((b) => b.addEventListener('click', () => { show(Number(b.dataset.i)); dlg.showModal(); }));
    dlg.querySelector('.vclose')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.vprev')!.addEventListener('click', () => show(cur - 1));
    dlg.querySelector('.vnext')!.addEventListener('click', () => show(cur + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    document.addEventListener('keydown', (e) => {
      if (!dlg.open) return;
      if (e.key === 'ArrowRight') show(cur + 1);
      if (e.key === 'ArrowLeft') show(cur - 1);
    });
    let x0: number | null = null;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1));
    });
  </script>

  <style is:global>
    :root { --ivory: #f6f2ec; --paper: #fffdf9; --ink: #1d1b19; --muted: #7a726a; --line: #d9d1c6; --gold: #a8854f; }
    * { box-sizing: border-box; }
    html { background: var(--ivory); color: var(--ink); -webkit-text-size-adjust: 100%; }
    body { margin: 0; font-family: 'Jost', system-ui, sans-serif; font-weight: 300; line-height: 1.5; }
    a { color: inherit; }
    .head { text-align: center; padding: clamp(3rem, 9vw, 7rem) 1.25rem clamp(2rem, 5vw, 3.5rem); max-width: 56rem; margin: 0 auto; }
    .eyebrow { margin: 0; letter-spacing: 0.32em; text-transform: uppercase; font-size: 0.75rem; color: var(--gold); font-weight: 400; }
    h1 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 300; font-size: clamp(2.4rem, 7vw, 5.2rem); line-height: 1.02; letter-spacing: 0.01em; margin: 1rem 0 0.75rem; }
    .sub { margin: 0; color: var(--muted); font-size: clamp(0.95rem, 1.6vw, 1.1rem); }
    .rule { width: 3.5rem; height: 1px; background: var(--gold); margin: 2rem auto 1.25rem; }
    .count { margin: 0 0 1.75rem; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
    .btn { display: inline-flex; flex-direction: column; align-items: center; gap: 0.15rem; min-height: 3.5rem; justify-content: center;
      padding: 0.85rem 2.25rem; background: var(--ink); color: var(--paper); text-decoration: none; border-radius: 999px;
      font-size: 1rem; font-weight: 400; letter-spacing: 0.02em; transition: background 0.2s; }
    .btn:hover { background: #3a342e; }
    .btn .ro { font-size: 0.72rem; opacity: 0.7; letter-spacing: 0.04em; }
    .note { margin: 0.9rem 0 0; font-size: 0.78rem; color: var(--muted); }
    .ro-note { opacity: 0.85; }
    .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; padding: 0 0.6rem; max-width: 110rem; margin: 0 auto; }
    @media (min-width: 701px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; padding: 0 1.5rem; } }
    @media (min-width: 1201px) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; padding: 0 2.5rem; } }
    .item { margin: 0; min-width: 0; }
    .item.wide { grid-column: span 2; }
    .open { display: block; width: 100%; padding: 0; border: 0; background: var(--line); cursor: zoom-in; aspect-ratio: 2 / 3; overflow: hidden; }
    .item.wide .open { aspect-ratio: 3 / 2; }
    .open img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(.2,.7,.2,1); }
    @media (hover: hover) { .open:hover img { transform: scale(1.02); } }
    figcaption { display: flex; justify-content: space-between; align-items: center; min-height: 2.6rem; font-size: 0.8rem; color: var(--muted); }
    figcaption a { text-decoration: none; border-bottom: 1px solid var(--line); padding-block: 0.6rem; }
    figcaption a:hover { color: var(--ink); border-color: var(--ink); }
    .foot { text-align: center; padding: clamp(3rem, 8vw, 6rem) 1.25rem 3rem; }
    .credit { margin: 2.5rem 0 0; font-size: 0.8rem; color: var(--muted); }
    .credit a { text-decoration: none; border-bottom: 1px solid var(--line); }
    .viewer { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #11100f; color: #f6f2ec; }
    .viewer::backdrop { background: #11100f; }
    .viewer[open] { display: grid; grid-template-columns: 3.5rem 1fr 3.5rem; grid-template-rows: auto 1fr; }
    .vbar { grid-column: 1 / -1; display: flex; align-items: center; gap: 1.25rem; padding: 0.75rem 1rem; padding-top: max(0.75rem, env(safe-area-inset-top)); font-size: 0.85rem; }
    .vcount { margin-right: auto; letter-spacing: 0.06em; }
    .vdl { color: inherit; border-bottom: 1px solid rgba(246,242,236,.4); text-decoration: none; padding-block: 0.5rem; }
    .vclose, .vprev, .vnext { background: none; border: 0; color: inherit; font-size: 1.6rem; cursor: pointer; min-width: 2.75rem; min-height: 2.75rem; }
    .vprev, .vnext { font-size: 2.6rem; font-family: 'Cormorant Garamond', serif; }
    .vimg { grid-row: 2; grid-column: 2; width: 100%; height: 100%; object-fit: contain; min-height: 0; transition: filter 0.3s; }
    .viewer[open]::after { content: ''; position: fixed; left: 0; right: 0; bottom: 0; height: 2px; background: #a8854f; transform-origin: left; transform: scaleX(0); opacity: 0; transition: opacity .2s; }
    .viewer[open]:has(.vimg.loading)::after { opacity: 1; animation: vload 1.2s ease-in-out infinite; }
    @keyframes vload { 0% { transform: scaleX(0); } 60% { transform: scaleX(.85); } 100% { transform: scaleX(1); opacity: 0; } }
    @media (max-width: 700px) {
      .viewer[open] { grid-template-columns: 0 1fr 0; }
      .vprev, .vnext { position: absolute; bottom: max(1rem, env(safe-area-inset-bottom)); }
      .vprev { left: 1rem; } .vnext { right: 1rem; }
    }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
  </style>
</body>
</html>
