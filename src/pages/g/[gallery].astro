---
/**
 * Unlisted client gallery: /g/<slug>/ for every manifest in src/data/client-galleries/.
 * A standalone page, separate from the portfolio site (no site nav, footer or motion), styled for the
 * client's event (Casmara: ivory, ink, a fine serif, a touch of gold). Kept out of search (robots meta
 * here, X-Robots-Tag in scripts/headers.mjs) and out of the sitemap; linked from no page.
 * Grid thumbnails come from src/assets/galleries/<id>/; the viewer uses 2560px renditions and every
 * download is the untouched full-size original in Vercel Blob.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import cover from '../../assets/uploads/casmara-hero-team.jpg';

interface Photo { name: string; url: string; width: number; height: number; bytes: number; }
interface Gallery {
  id: string; slug: string; title: string; subtitle: string; credit: string;
  zip: { name: string; url: string; bytes: number };
  photos: Photo[];
}

export function getStaticPaths() {
  const manifests = import.meta.glob<Gallery>('../../data/client-galleries/*.json', { eager: true, import: 'default' });
  return Object.values(manifests).map((gallery) => ({ params: { gallery: gallery.slug }, props: { gallery } }));
}

const { gallery } = Astro.props as { gallery: Gallery };
const sources = import.meta.glob<ImageMetadata>('../../assets/galleries/*/*.jpg', { eager: true, import: 'default' });
const photos = await Promise.all(
  gallery.photos.map(async (p, i) => {
    const src = sources[`../../assets/galleries/${gallery.id}/${p.name}`];
    if (!src) throw new Error(`Gallery ${gallery.id}: missing web-size file for ${p.name}`);
    const small = await getImage({ src, width: Math.min(600, src.width), format: 'webp', quality: 84 });
    const medium = await getImage({ src, width: Math.min(1200, src.width), format: 'webp', quality: 86 });
    return {
      ...p,
      number: String(i + 1).padStart(3, '0'),
      thumb: small.src,
      mid: medium.src,
      srcset: `${small.src} ${small.attributes.width ?? 600}w, ${medium.src} ${medium.attributes.width ?? 1200}w`,
      ratio: p.width / p.height,
    };
  }),
);
const coverSet = await getImage({ src: cover, widths: [800, 1280, 1920, 2560, 3200].filter((w) => w <= cover.width), format: 'webp', quality: 86 });
const download = (url: string) => `${url}?download=1`;
const mb = (bytes: number) => `${new Intl.NumberFormat('ru-RU', { maximumFractionDigits: bytes < 1e8 ? 1 : 0 }).format(bytes / 1e6)} МБ`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <title>{gallery.title} — фотографии</title>
  <meta name="description" content={`${gallery.title}: все фотографии с мероприятия.`} />
  <meta property="og:title" content={gallery.title} />
  <meta property="og:description" content={`${photos.length} фотографий · ${gallery.subtitle}`} />
  <meta property="og:image" content={new URL(coverSet.src, Astro.site).toString()} />
  <meta name="theme-color" content="#14110f" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" as="image" imagesrcset={coverSet.srcSet.attribute} imagesizes="100vw" fetchpriority="high" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Jost:wght@300;400&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="cover">
    <img class="cover__img" src={coverSet.src} srcset={coverSet.srcSet.attribute} sizes="100vw" alt="" fetchpriority="high" />
    <div class="cover__shade" aria-hidden="true"></div>
    <div class="cover__text">
      <p class="eyebrow">Casmara Moldova · Since 1974</p>
      <h1>{gallery.title}</h1>
      <p class="sub">{gallery.subtitle}</p>
    </div>
    <a class="scroll" href="#frames" aria-label="К фотографиям"><span></span></a>
  </header>

  <section class="intro">
    <p class="thanks">Спасибо, что были с нами.<br /><em>Vă mulțumim că ați fost alături de noi.</em></p>
    <div class="rule" aria-hidden="true"><span></span></div>
    <p class="count">{photos.length} фотографий · {photos.length} fotografii</p>
    <a class="btn" href={download(gallery.zip.url)} download={gallery.zip.name}>
      <span>Скачать все фото</span><span class="ro">Descărcați toate fotografiile</span>
    </a>
    <p class="note">ZIP · оригиналы в полном качестве · {mb(gallery.zip.bytes)}<br /><span>Любое фото можно открыть и скачать отдельно · Orice fotografie se poate descărca separat</span></p>
  </section>

  <main class="grid" id="frames" aria-label="Фотографии">
    {photos.map((p, i) => (
      <figure class="item" style={`aspect-ratio:${p.width}/${p.height}`}>
        <button type="button" class="open" data-i={i} aria-label={`Открыть фото ${p.number}`}>
          <img src={p.thumb} srcset={p.srcset} sizes="(max-width: 700px) 50vw, (max-width: 1200px) 33vw, 25vw" alt={`${gallery.title}, фото ${p.number}`} width={p.width} height={p.height} loading={i < 8 ? 'eager' : 'lazy'} decoding="async" />
        </button>
        <a class="dl" href={download(p.url)} download={p.name} aria-label={`Скачать фото ${p.number}, ${mb(p.bytes)}`} title={`Скачать · ${mb(p.bytes)}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" /></svg>
        </a>
      </figure>
    ))}
  </main>

  <footer class="foot">
    <p class="mono" aria-hidden="true">CASMARA</p>
    <a class="btn" href={download(gallery.zip.url)} download={gallery.zip.name}>
      <span>Скачать все фото</span><span class="ro">Descărcați toate fotografiile</span>
    </a>
    <p class="credit">Фото · Fotografii — <a href="https://ellinayatsenyuk.com/" target="_blank" rel="noopener">Эллина Яценюк</a> · © {year}</p>
  </footer>

  <a class="float" href={download(gallery.zip.url)} download={gallery.zip.name} aria-hidden="true" tabindex="-1">Скачать все · {mb(gallery.zip.bytes)}</a>

  <dialog class="viewer" aria-label="Просмотр фото">
    <div class="vbar">
      <span class="vcount" aria-live="polite"></span>
      <a class="vdl" href="#" download>Скачать оригинал</a>
      <button type="button" class="vclose" aria-label="Закрыть">✕</button>
    </div>
    <button type="button" class="vprev" aria-label="Предыдущее">‹</button>
    <img class="vimg" alt="" />
    <button type="button" class="vnext" aria-label="Следующее">›</button>
  </dialog>

  <script type="application/json" id="photos" set:html={JSON.stringify(photos.map((p) => ({ n: p.number, preview: p.mid, full: `/gallery/${gallery.id}/${p.number}.webp`, dl: download(p.url), name: p.name })))} />
  <script>
    const data: { n: string; preview: string; full: string; dl: string; name: string }[] = JSON.parse(document.getElementById('photos')!.textContent || '[]');
    const dlg = document.querySelector<HTMLDialogElement>('.viewer')!;
    const img = dlg.querySelector<HTMLImageElement>('.vimg')!;
    const count = dlg.querySelector<HTMLElement>('.vcount')!;
    const dl = dlg.querySelector<HTMLAnchorElement>('.vdl')!;
    let cur = 0;
    const hq = new Map<string, boolean>();
    const pending = new Map<string, Promise<void>>();
    const load = (url: string) => {
      if (hq.get(url)) return Promise.resolve();
      if (!pending.has(url)) pending.set(url, new Promise<void>((res) => {
        const im = new Image();
        im.onload = () => { hq.set(url, true); im.decode?.().catch(() => {}).finally(() => res()) ?? res(); };
        im.onerror = () => res();
        im.src = url;
      }));
      return pending.get(url)!;
    };
    const show = (i: number) => {
      cur = (i + data.length) % data.length;
      const p = data[cur];
      // Large viewer image (2560px, visually lossless). Until it arrives, the grid preview holds the
      // place with a thin progress line — never a blurred frame. Downloads stay the untouched original.
      const ready = hq.get(p.full);
      if (ready) { img.src = p.full; img.classList.remove('loading'); }
      else {
        img.src = p.preview; img.classList.add('loading');
        load(p.full).then(() => { if (data[cur] === p) { img.src = p.full; img.classList.remove('loading'); } });
      }
      count.textContent = `${p.n} / ${data.length}`;
      dl.href = p.dl; dl.setAttribute('download', p.name);
      // Fetch the neighbours ahead so swiping is instant
      [cur + 1, cur - 1, cur + 2].forEach((j) => load(data[(j + data.length) % data.length].full));
    };
    document.querySelectorAll<HTMLButtonElement>('.open').forEach((b) => b.addEventListener('click', () => { show(Number(b.dataset.i)); dlg.showModal(); }));
    dlg.querySelector('.vclose')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.vprev')!.addEventListener('click', () => show(cur - 1));
    dlg.querySelector('.vnext')!.addEventListener('click', () => show(cur + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    document.addEventListener('keydown', (e) => {
      if (!dlg.open) return;
      if (e.key === 'ArrowRight') show(cur + 1);
      if (e.key === 'ArrowLeft') show(cur - 1);
    });
    let x0: number | null = null;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1));
    });
  </script>
  <script>
    // Quiet touches only: thumbnails fade in once decoded; the "download all" pill appears after the intro
    document.querySelectorAll<HTMLImageElement>('.item img').forEach((im) => {
      const done = () => im.closest('.item')!.classList.add('is-in');
      if (im.complete && im.naturalWidth) done(); else { im.addEventListener('load', done, { once: true }); im.addEventListener('error', done, { once: true }); }
    });
    const intro = document.querySelector('.intro')!;
    const foot = document.querySelector('.foot')!;
    const float = document.querySelector<HTMLElement>('.float')!;
    let pastIntro = false, atFoot = false;
    const sync = () => float.classList.toggle('on', pastIntro && !atFoot);
    new IntersectionObserver(([e]) => { pastIntro = !e.isIntersecting && e.boundingClientRect.top < 0; sync(); }).observe(intro);
    new IntersectionObserver(([e]) => { atFoot = e.isIntersecting; sync(); }).observe(foot);
  </script>

  <style is:global>
    :root { --ivory: #f5f0e9; --paper: #fffcf7; --ink: #1c1a18; --muted: #857b71; --line: #ddd3c7; --gold: #a8854f; --night: #14110f; }
    * { box-sizing: border-box; }
    html { background: var(--ivory); color: var(--ink); -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
    body { margin: 0; font-family: 'Jost', system-ui, sans-serif; font-weight: 300; line-height: 1.55; }
    a { color: inherit; }

    .cover { position: relative; height: 100svh; min-height: 32rem; max-height: 62rem; overflow: hidden; background: var(--night); color: #fbf7f1; display: grid; align-items: end; }
    .cover__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
    .cover__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(20 17 15 / .35) 0%, rgb(20 17 15 / 0) 30%, rgb(20 17 15 / .15) 55%, rgb(20 17 15 / .82) 100%); }
    .cover__text { position: relative; text-align: center; padding: 0 1.25rem clamp(4.5rem, 11vh, 7rem); }
    .eyebrow { margin: 0; letter-spacing: .34em; text-transform: uppercase; font-size: .72rem; font-weight: 400; color: #e3cfa6; }
    h1 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 300; font-size: clamp(2.6rem, 7.4vw, 6.2rem); line-height: 1; letter-spacing: .005em; margin: 1rem auto .9rem; max-width: 14ch; text-wrap: balance; }
    .sub { margin: 0; font-size: clamp(.95rem, 1.5vw, 1.1rem); color: rgb(251 247 241 / .82); }
    .scroll { position: absolute; left: 50%; bottom: 1.6rem; width: 1px; height: 2.6rem; transform: translateX(-50%); overflow: hidden; }
    .scroll span { position: absolute; inset: 0; background: linear-gradient(#e3cfa6, transparent); }

    .intro { text-align: center; padding: clamp(3.5rem, 9vw, 6rem) 1.25rem clamp(3rem, 7vw, 4.5rem); max-width: 44rem; margin: 0 auto; }
    .thanks { margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.6rem, 3.4vw, 2.3rem); line-height: 1.2; font-weight: 300; }
    .thanks em { display: block; margin-top: .4rem; font-size: .62em; color: var(--muted); }
    .rule { display: flex; align-items: center; justify-content: center; gap: .8rem; margin: 2rem auto 1.4rem; }
    .rule::before, .rule::after { content: ''; width: 3rem; height: 1px; background: var(--gold); opacity: .7; }
    .rule span { width: 5px; height: 5px; transform: rotate(45deg); background: var(--gold); }
    .count { margin: 0 0 1.8rem; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
    .btn { display: inline-flex; flex-direction: column; align-items: center; gap: .15rem; min-height: 3.6rem; justify-content: center;
      padding: .9rem 2.6rem; background: var(--ink); color: var(--paper); text-decoration: none; border-radius: 999px;
      font-size: 1rem; font-weight: 400; letter-spacing: .03em; transition: background .25s, transform .25s; }
    .btn:hover { background: #3b342d; transform: translateY(-1px); }
    .btn .ro { font-size: .72rem; opacity: .65; letter-spacing: .04em; }
    .note { margin: 1rem 0 0; font-size: .78rem; color: var(--muted); }
    .note span { opacity: .85; }

    .grid { columns: 2; column-gap: .5rem; padding: 0 .5rem; max-width: 112rem; margin: 0 auto; }
    @media (min-width: 701px) { .grid { columns: 3; column-gap: .9rem; padding: 0 1.25rem; } }
    @media (min-width: 1201px) { .grid { columns: 4; column-gap: 1.1rem; padding: 0 2.25rem; } }
    .item { position: relative; margin: 0 0 .5rem; break-inside: avoid; background: #e8e0d5; overflow: hidden; }
    @media (min-width: 701px) { .item { margin-bottom: .9rem; } }
    @media (min-width: 1201px) { .item { margin-bottom: 1.1rem; } }
    .open { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
    .open img { display: block; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .7s ease, transform 1.2s cubic-bezier(.2,.7,.2,1); }
    .item.is-in .open img { opacity: 1; }
    @media (hover: hover) { .open:hover img { transform: scale(1.025); } }
    .dl { position: absolute; right: .55rem; bottom: .55rem; width: 2.5rem; height: 2.5rem; display: grid; place-items: center; border-radius: 50%;
      background: rgb(255 252 247 / .9); color: var(--ink); box-shadow: 0 2px 10px rgb(0 0 0 / .15); transition: opacity .25s, background .2s; }
    .dl svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    .dl:hover { background: #fff; }
    @media (hover: hover) { .dl { opacity: 0; } .item:hover .dl, .dl:focus-visible { opacity: 1; } }

    .foot { text-align: center; padding: clamp(4rem, 10vw, 7rem) 1.25rem 3rem; }
    .mono { margin: 0 0 2rem; font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2rem, 5vw, 3.2rem); letter-spacing: .32em; font-weight: 300; color: var(--gold); padding-left: .32em; }
    .credit { margin: 2.6rem 0 0; font-size: .8rem; color: var(--muted); letter-spacing: .02em; }
    .credit a { text-decoration: none; border-bottom: 1px solid var(--line); }

    .float { position: fixed; left: 50%; bottom: max(1rem, env(safe-area-inset-bottom)); transform: translate(-50%, 1rem); opacity: 0; pointer-events: none;
      padding: .7rem 1.4rem; border-radius: 999px; background: rgb(28 26 24 / .92); color: var(--paper); text-decoration: none; font-size: .85rem;
      letter-spacing: .03em; box-shadow: 0 6px 24px rgb(0 0 0 / .2); transition: opacity .3s, transform .3s; z-index: 5; white-space: nowrap; }
    .float.on { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }

    .viewer { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #11100f; color: #f6f2ec; }
    .viewer::backdrop { background: #11100f; }
    .viewer[open] { display: grid; grid-template-columns: 3.5rem 1fr 3.5rem; grid-template-rows: auto 1fr; }
    .vbar { grid-column: 1 / -1; display: flex; align-items: center; gap: 1.25rem; padding: .75rem 1rem; padding-top: max(.75rem, env(safe-area-inset-top)); font-size: .85rem; }
    .vcount { margin-right: auto; letter-spacing: .06em; }
    .vdl { color: inherit; border-bottom: 1px solid rgba(246,242,236,.4); text-decoration: none; padding-block: .5rem; }
    .vclose, .vprev, .vnext { background: none; border: 0; color: inherit; font-size: 1.6rem; cursor: pointer; min-width: 2.75rem; min-height: 2.75rem; }
    .vprev, .vnext { font-size: 2.6rem; font-family: 'Cormorant Garamond', serif; }
    .vimg { grid-row: 2; grid-column: 2; width: 100%; height: 100%; object-fit: contain; min-height: 0; }
    .viewer[open]::after { content: ''; position: fixed; left: 0; right: 0; bottom: 0; height: 2px; background: var(--gold); transform-origin: left; transform: scaleX(0); opacity: 0; transition: opacity .2s; }
    .viewer[open]:has(.vimg.loading)::after { opacity: 1; animation: vload 1.2s ease-in-out infinite; }
    @keyframes vload { 0% { transform: scaleX(0); } 60% { transform: scaleX(.85); } 100% { transform: scaleX(1); opacity: 0; } }
    @media (max-width: 700px) {
      .viewer[open] { grid-template-columns: 0 1fr 0; }
      .vprev, .vnext { position: absolute; bottom: max(1rem, env(safe-area-inset-bottom)); }
      .vprev { left: 1rem; } .vnext { right: 1rem; }
    }
    @media (prefers-reduced-motion: reduce) { *, *::after { transition: none !important; animation: none !important; } .open img { opacity: 1; } }
  </style>
</body>
</html>
