---
import Base from '../layouts/Base.astro';
---

<Base page="404" title="Page not found" noindex>
  <section class="notfound">
    <h1 class="display" data-split="now">Out of frame</h1>
    <p class="muted">This page doesn't exist, or it has moved. The work is still here.</p>
    <div class="cta__actions" style="justify-content:center;margin:0">
      <a class="btn btn--solid" href="/portfolio/">Open the portfolio</a>
      <a class="btn" href="/">Go to the home page</a>
    </div>
  </section>
</Base>
