---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import { getProjects, getFilms, fullSize, type Project } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}
interface Props { project: Project; next: Project; }
const { project, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const films = (await getFilms()).filter((f) => f.data.project === project.id);
const gallery = await Promise.all(d.gallery.map(async (g) => ({ ...g, full: await fullSize(g.image) })));
const filmPosters = await Promise.all(films.map((f) => getImage({ src: f.data.poster, width: 1600, format: 'webp' })));

const sizesFor: Record<string, string> = {
  full: '100vw',
  wide: '(max-width: 760px) 100vw, 84vw',
  half: '(max-width: 760px) 100vw, 50vw',
  'inset-left': '(max-width: 760px) 100vw, 42vw',
  'inset-right': '(max-width: 760px) 100vw, 42vw',
};
const ld = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  description: d.seoDescription ?? d.excerpt,
  creator: { '@type': 'Person', name: 'Ellina Iateniuc' },
  dateCreated: String(d.year),
  locationCreated: d.location,
  genre: d.category,
};
const titleWords = d.title.split(' ');
const half = Math.ceil(titleWords.length / 2);
const titleLines = titleWords.length > 2 ? [titleWords.slice(0, half).join(' '), titleWords.slice(half).join(' ')] : [d.title];
---

<Base page="work" title={d.title} description={d.seoDescription ?? d.excerpt} image={d.cover} imageAlt={d.coverAlt} type="article" jsonLd={ld}>
  <section class="p-hero" data-hero>
    <Frame src={d.cover} alt={d.coverAlt} eager aperture={false} sizes="100vw">
      {d.coverVideo && <video autoplay muted loop playsinline preload="metadata" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"><source src={d.coverVideo} type="video/mp4" /></video>}
    </Frame>
    <div class="p-hero__text" data-hero-text>
      <h1 class="display">
        {titleLines.map((l) => <span class="line" data-split="now">{l}</span>)}
      </h1>
      {d.subtitle && <p class="p-hero__sub">{d.subtitle}</p>}
    </div>
  </section>

  <dl class="p-facts">
    <div><dt>Category</dt><dd>{d.category}</dd></div>
    {d.client && <div><dt>Client</dt><dd>{d.client}</dd></div>}
    {d.location && <div><dt>Location</dt><dd>{d.location}</dd></div>}
    <div><dt>Year</dt><dd class="tnum">{d.year}</dd></div>
  </dl>

  <section class="p-story wrap grid12">
    <p class="lede" data-split>{d.excerpt}</p>
    <div class="prose"><Content /></div>
  </section>

  <section class="p-gallery" aria-label={`${d.title} photographs`}>
    {gallery.map((g) => (
      <figure class={`g-${g.layout}`}>
        <button data-lb-item data-full={g.full} data-alt={g.alt} data-caption={g.caption ?? ''} data-cursor="Expand" aria-label={`Open full screen: ${g.alt}`}>
          <Frame src={g.image} alt={g.alt} parallax={g.layout === 'full' || g.layout === 'wide'} sizes={sizesFor[g.layout]} style={g.layout === 'full' ? 'aspect-ratio:16/9' : `aspect-ratio:${g.image.width}/${g.image.height}`} />
        </button>
        {g.caption && <figcaption>{g.caption}</figcaption>}
      </figure>
    ))}
  </section>

  {films.length > 0 && (
    <section class="wrap" style="padding-bottom: var(--section)" aria-label="Film from this event">
      <div class="section-head"><h2>The film</h2></div>
      {films.map((f, i) => (
        <div class="film-card" data-preview>
          <button data-film data-title={f.data.title} data-src={f.data.videoFile} data-url={f.data.videoUrl} data-poster={filmPosters[i].src} data-cursor="Play" data-cursor-mode="play" aria-label={`Play ${f.data.title}`}>
            <Frame src={f.data.poster} alt={f.data.posterAlt} sizes="100vw" style="aspect-ratio:21/9">
              {f.data.previewFile && <video muted loop playsinline preload="none" data-src={f.data.previewFile} aria-hidden="true"></video>}
            </Frame>
          </button>
          <h3>{f.data.title}</h3>
          <p>{f.data.excerpt}</p>
        </div>
      ))}
    </section>
  )}

  {d.credits.length > 0 && (
    <section class="p-credits" aria-labelledby="credits-h">
      <h2 id="credits-h">Credits</h2>
      <dl>
        {d.credits.map((c) => <div><dt>{c.role}</dt><dd>{c.name}</dd></div>)}
      </dl>
    </section>
  )}

  {next.id !== project.id && (
    <a class="next" href={`/work/${next.id}/`} data-cursor="Next event">
      <Frame src={next.data.cover} alt="" aperture={false} sizes="100vw" widths={[800, 1400, 2000]} />
      <div class="next__text">
        <span>Next event</span>
        <h2 class="display">{next.data.title}</h2>
      </div>
    </a>
  )}
</Base>
