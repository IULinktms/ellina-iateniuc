---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import { getSite, getHome, getProjects, getFilms, orientation, slugify } from '../lib/content';

const site = await getSite();
const home = await getHome();
const projects = await getProjects();
const films = (await getFilms()).filter((f) => f.data.featured);

const featured = home.featuredProjects
  .map((slug) => projects.find((p) => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const counts = Object.fromEntries(
  home.disciplines.map((d) => [d.category, projects.filter((p) => p.data.category === d.category).reduce((n, p) => n + p.data.gallery.length + 1, 0)]),
);
const poster = await getImage({ src: home.heroPoster, width: 1600, format: 'webp', quality: 70 });
const filmPosters = await Promise.all(films.map((f) => getImage({ src: f.data.poster, width: 1600, format: 'webp', quality: 78 })));
---

<Base page="home">
  <!-- Opening sequence: covers the hero until the shutter opens -->
  <div class="intro" aria-hidden="true">
    <div class="intro__bars"><i></i><i></i></div>
    <span class="intro__line"></span>
    <span class="intro__count">00:00:00:00</span>
  </div>

  <section class="hero" data-hero aria-label="Introduction">
    <div class="hero__media">
      <video
        data-hero-video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={poster.src}
        aria-label={home.heroPosterAlt}
      >
        <source src={home.heroVideo} type="video/mp4" />
      </video>
    </div>
    <div data-hero-text>
      <h1 class="hero__name display">
        <span class="line"><span class="w">{site.firstName}</span></span>
        <span class="line"><span class="w">{site.lastName}</span></span>
      </h1>
      <div class="hero__meta">
        <p>{site.role}<br /><span class="muted">{site.location}</span></p>
        <span class="hero__tc" data-timecode aria-hidden="true">00:00:00:00</span>
      </div>
    </div>
  </section>

  <section class="statement wrap grid12" aria-label="Approach">
    <p data-statement>{home.statement}</p>
    <div class="statement__aside">
      <a class="line-link" href="/about/">How I work on the day</a>
    </div>
  </section>

  <section class="spreads wrap" aria-labelledby="sel-h">
    <div class="section-head">
      <h2 id="sel-h">Selected work</h2>
      <a class="line-link small" href="/portfolio/">Full portfolio</a>
    </div>
    {featured.map((p, i) => {
      const land = orientation(p.data.cover) === 'landscape';
      return (
        <article class="spread">
          <Frame
            src={p.data.cover}
            alt={p.data.coverAlt}
            class:list={['spread__frame', land && 'spread__frame--land']}
            parallax
            sizes="(max-width: 760px) 100vw, 60vw"
            data-cursor="View event"
          />
          <div class="spread__text">
            <h3 class:list={['spread__title display', p.data.title.length > 14 && 'spread__title--long']} data-split>{p.data.title}</h3>
            <div class="spread__meta tnum"><span>{p.data.category}</span><span>{p.data.location}</span><span>{p.data.year}</span></div>
            <p class="spread__excerpt">{p.data.excerpt}</p>
          </div>
          <a class="spread__link" href={`/work/${p.id}/`} data-cursor="View event" aria-label={`${p.data.title}, view the project`}></a>
        </article>
      );
    })}
  </section>

  {films.length > 0 && (
    <section class="strip" data-strip aria-labelledby="films-h">
      <div class="section-head wrap">
        <h2 id="films-h">Aftermovies &amp; reels</h2>
        <a class="line-link small" href="/films/">All films</a>
      </div>
      <div class="strip__viewport">
        <div class="strip__track">
          {films.map((f, i) => (
            <article class="strip__item" data-preview>
              <button
                class="frame-btn"
                style="display:block;width:100%;text-align:left"
                data-film
                data-title={f.data.title}
                data-src={f.data.videoFile}
                data-url={f.data.videoUrl}
                data-poster={filmPosters[i].src}
                data-cursor="Play"
                data-cursor-mode="play"
                aria-label={`Play ${f.data.title}`}
              >
                <div class="frame">
                  <Image src={f.data.poster} alt={f.data.posterAlt} widths={[640, 1000, 1400]} sizes="(max-width: 900px) 82vw, 46vw" format="webp" quality={78} loading="lazy" />
                  {f.data.previewFile && <video muted loop playsinline preload="none" data-src={f.data.previewFile} aria-hidden="true"></video>}
                </div>
                <div class="strip__caption">
                  <h3>{f.data.title}</h3>
                  <span>{f.data.kind}, {f.data.duration}</span>
                </div>
              </button>
            </article>
          ))}
          <div class="strip__end"><a class="btn" href="/films/">See every film</a></div>
        </div>
      </div>
    </section>
  )}

  <section class="disciplines light" aria-labelledby="disc-h" style="margin-top: var(--section)">
    <div class="wrap">
      <div class="section-head" style="color:#000">
        <h2 id="disc-h">What I cover</h2>
        <span class="small" style="color:#6b665f">Choose one to see the work</span>
      </div>
      <ul role="list" data-float-list>
        {home.disciplines.map((d) => (
          <li>
            <a href={`/portfolio/?c=${slugify(d.category)}`} data-float={slugify(d.label)} data-cursor="Open">
              <span class="display">{d.label}</span>
              <span class="count">{counts[d.category] ?? 0} photographs</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="float-preview" aria-hidden="true">
      {home.disciplines.map((d) => (
        <Image src={d.image} alt="" widths={[400, 700]} sizes="22vw" format="webp" quality={75} loading="lazy" data-key={slugify(d.label)} />
      ))}
    </div>
  </section>

  <section class="cta wrap" aria-labelledby="cta-h">
    <h2 id="cta-h" class="display" data-split>{home.ctaTitle}</h2>
    <p>{home.ctaText}</p>
    <div class="cta__actions">
      <a class="btn btn--solid" href="/contact/">Book your event</a>
      <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </section>
</Base>
