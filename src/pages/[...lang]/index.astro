---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import DeliveryCalc from '../../components/DeliveryCalc.astro';
import ContactSheet from '../../components/ContactSheet.astro';
import StudioProof from '../../components/StudioProof.astro';
import { getSite, getHome, getProjects, getFilms, projectPhotos, orientation, slugify, slugOf } from '../../lib/content';
import { whatsappHref } from '../../lib/whatsapp';
import { langParams, localePath, t, type Lang } from '../../lib/i18n';
import { lqip } from '../../lib/lqip';

export const getStaticPaths = langParams;
const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const L = (p: string) => localePath(lang, p);

const site = await getSite(lang);
const home = await getHome(lang);
const projects = await getProjects(lang);
const films = (await getFilms(lang)).filter((f) => f.data.featured);

const featured = home.featuredProjects
  .map((slug) => projects.find((p) => slugOf(p) === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const counts = Object.fromEntries(
  home.disciplines.map((d) => [d.category, projects.filter((p) => p.data.category === d.category).reduce((n, p) => n + projectPhotos(p).length, 0)]),
);
// Only published work gets a category tile. New categories appear with their first project.
const disciplines = home.disciplines.flatMap((d) => {
  const project = projects.find((p) => p.data.category === d.category);
  return project ? [{ ...d, image: d.image ?? project.data.cover, alt: d.alt || project.data.coverAlt }] : [];
});
// A single tile is not a list of what I cover: the list waits for a second category, the intro stays
const showDisciplines = disciplines.length > 1;
// Primary booking action: WhatsApp with the message prefilled; the date calculator below stays as the second step
const whatsapp = whatsappHref(site.whatsapp, lang);
// LCP: a responsive still paints first; a video, if set, loads after (see deferHeroVideo in app.ts).
// A portrait still covers a phone at its height and a desktop at its width, so the candidates go up to 2560
const posterSet = await getImage({ src: home.heroPoster, widths: [640, 960, 1280, 1920, 2560].filter((w) => w <= home.heroPoster.width), format: 'webp', quality: 72 });
const posterPortrait = home.heroPoster.height > home.heroPoster.width;
// Rendered width of an object-fit: cover still: 100vw, or wider on a tall screen when the photo is narrower than the screen ratio
const posterSizes = `(max-aspect-ratio: ${home.heroPoster.width}/${home.heroPoster.height}) ${Math.ceil((home.heroPoster.width / home.heroPoster.height) * 100)}vh, 100vw`;
const filmPosters = await Promise.all(films.map((f) => getImage({ src: f.data.poster, width: 1600, format: 'webp', quality: 78 })));
// Blurred previews behind photos that load later (lib/lqip.ts)
const heroPlaceholder = await lqip(home.heroPoster);
// The day-by-the-hour timeline only shows real event photos: it stays hidden until every moment has one
const runOfShow = home.runOfShow.every((r) => r.image) ? home.runOfShow.map((r) => ({ ...r, image: r.image! })) : [];
const rosPlaceholders = await Promise.all(runOfShow.map((r) => lqip(r.image)));
const filmPlaceholders = await Promise.all(films.map((f) => lqip(f.data.poster)));
---

<Base page="home" lang={lang}>
  <link slot="head" rel="preload" as="image" type="image/webp" imagesrcset={posterSet.srcSet.attribute} imagesizes={posterSizes} fetchpriority="high" />
  <!-- Opening sequence: covers the hero until the shutter opens -->
  <div class="intro" aria-hidden="true">
    <div class="intro__bars"><i></i><i></i></div>
    <span class="intro__line"></span>
  </div>

  <section class="hero" data-hero aria-labelledby="hero-title">
    <div class="hero__media" data-lqip={heroPlaceholder ? 'eager' : undefined} style={heroPlaceholder?.style} {...heroPlaceholder?.attrs}>
      <img src={posterSet.src} srcset={posterSet.srcSet.attribute} sizes={posterSizes} alt={home.heroPosterAlt} fetchpriority="high" decoding="async" class:list={['hero__poster', posterPortrait && 'hero__poster--portrait']} data-hero-still />
      {home.heroVideo && <video data-hero-video muted loop playsinline preload="none" aria-hidden="true" data-src={home.heroVideo}></video>}
    </div>
    <div class="hero__shutter" data-home-shutter aria-hidden="true"></div>
    <div class="hero__text" data-hero-text>
      <h1 class="hero__name display" id="hero-title">
        <span class="line"><span class="w">{site.firstName}</span></span>
        <span class="line"><span class="w">{site.lastName}</span></span>
      </h1>
      <div class="hero__row">
        <p class="hero__lede" data-hero-rise>{s.home.lede}</p>
        <div class="hero__actions" data-hero-rise>
          {whatsapp ? <a class="btn btn--solid" href={whatsapp}>{s.bookingUi.waCta}</a> : <a class="btn btn--solid" href="#delivery">{s.home.checkDate}</a>}
          <a class="line-link" href={L('/portfolio/')}>{s.home.seeWork}</a>
        </div>
      </div>
      <div class="hero__meta" data-hero-rise>
        <span>{site.location}</span>
      </div>
    </div>
  </section>

  <ContactSheet lang={lang} />

  <section class="spreads wrap" aria-labelledby="sel-h">
    <div class="section-head">
      <h2 id="sel-h">{s.home.selected}</h2>
      <a class="line-link small" href={L('/portfolio/')}>{s.home.fullPortfolio}</a>
    </div>
    {featured.map((p) => {
      const land = orientation(p.data.cover) === 'landscape';
      const slug = slugOf(p);
      return (
        <article class="spread" data-preview>
          <div class:list={['spread__frame', land && 'spread__frame--land']} transition:name={`cover-${slug}`} data-cursor={s.cursor.view}>
            <Frame src={p.data.cover} alt={p.data.coverAlt} parallax sizes="(max-width: 760px) 100vw, 60vw">
              {p.data.coverVideo && <video muted loop playsinline preload="none" data-src={p.data.coverVideo} aria-hidden="true"></video>}
            </Frame>
          </div>
          <div class="spread__text">
            <h3 class:list={['spread__title display', p.data.title.length > 14 && 'spread__title--long']} data-split>{p.data.title}</h3>
            <div class="spread__meta tnum"><span>{s.categories[p.data.category]}</span><span>{p.data.location}</span><span>{p.data.year}</span></div>
            <p class="spread__excerpt">{p.data.excerpt}</p>
          </div>
          <a class="spread__link" href={L(`/work/${slug}/`)} data-cursor={s.cursor.view} aria-label={s.work.view(p.data.title)}></a>
        </article>
      );
    })}
  </section>

  <StudioProof lang={lang} home={home} />

  <section class="howi wrap" id="delivery" aria-labelledby="howi-h">
    <div class="howi__text" data-reveal>
      <h2 id="howi-h" class="display howi__title">{home.statementTitle}</h2>
      <p class="howi__statement">{home.statement}</p>
      <a class="line-link small" href={L('/about/')}>{s.home.howBooking}</a>
    </div>
    <div class="howi__calc" data-reveal>
      <DeliveryCalc lang={lang} whatsapp={site.whatsapp} previewTime={site.delivery.previewTime} galleryDays={site.delivery.galleryDays} filmDays={site.delivery.filmDays} id="home-calc" />
    </div>
  </section>

  {runOfShow.length > 0 && (
    <section class="ros" aria-labelledby="ros-h" data-ros>
      <div class="wrap ros__head" data-reveal>
        <h2 id="ros-h" class="display ros__title">{home.runOfShowTitle}</h2>
      </div>
      <div class="ros__body wrap">
        <figure class="ros__media" aria-hidden="true">
          <div class="ros__pictures" data-lqip={rosPlaceholders[0] ? 'eager' : undefined} style={rosPlaceholders[0]?.style} {...rosPlaceholders[0]?.attrs}>
            {runOfShow.map((r, i) => (
              <Image src={r.image} alt="" widths={[640, 1000, 1400]} width={1400} sizes="(max-width: 800px) 100vw, 55vw" format="webp" quality={78} loading="lazy" class:list={[i === 0 && 'is-on']} />
            ))}
          </div>
          <figcaption class="ros__clock tnum" data-ros-clock>{runOfShow[0].time}</figcaption>
        </figure>
        <ol class="ros__list" role="list">
          {runOfShow.map((r, i) => (
            <li class="ros__item" data-ros-item data-time={r.time}>
              <time class="ros__time tnum">{r.time}</time>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
              <Image src={r.image} alt={r.alt} widths={[640, 1000]} width={1000} sizes="100vw" format="webp" quality={76} loading="lazy" class="ros__inline" style={rosPlaceholders[i]?.style} {...rosPlaceholders[i]?.attrs} />
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {films.length > 0 && (
    <section class:list={['strip', films.length === 1 && 'strip--single']} data-strip aria-labelledby="films-h">
      <div class="section-head wrap">
        <h2 id="films-h">{s.home.filmsHead}</h2>
        <a class="line-link small" href={L('/films/')}>{s.home.allFilms}</a>
      </div>
      <div class="strip__viewport">
        <div class="strip__track">
          {films.map((f, i) => (
            <article class:list={['strip__item', f.data.aspectRatio === 'portrait' && 'strip__item--vertical']} data-preview>
              <button class="frame-btn" data-film data-aspect={f.data.aspectRatio} data-title={f.data.title} data-src={f.data.videoFile} data-url={f.data.videoUrl} data-poster={filmPosters[i].src} data-cursor={s.cursor.play} data-cursor-mode="play">
                <span class="sr-only">{s.a11y.play(f.data.title)}</span>
                <div class="frame" data-lqip={filmPlaceholders[i] ? '' : undefined} style={filmPlaceholders[i]?.style} {...filmPlaceholders[i]?.attrs}>
                  <Image src={f.data.poster} alt={f.data.posterAlt} widths={[640, 1000, 1400]} width={1400} sizes={f.data.aspectRatio === 'portrait' ? '(max-width: 900px) 46vw, 17vw' : '(max-width: 900px) 82vw, 46vw'} format="webp" quality={78} loading="lazy" />
                  {f.data.previewFile && <video muted loop playsinline preload="none" data-src={f.data.previewFile} aria-hidden="true"></video>}
                </div>
                <div class="strip__caption">
                  <h3>{f.data.title}</h3>
                  <span>{s.kinds[f.data.kind]}, {f.data.duration}</span>
                </div>
              </button>
            </article>
          ))}
          {/* One film is a feature, not a shelf: no sideways travel and no "every film" stop at its end */}
          {films.length > 1 && <div class="strip__end"><a class="btn" href={L('/films/')}>{s.home.everyFilm}</a></div>}
        </div>
      </div>
    </section>
  )}

  {(showDisciplines || home.disciplinesIntro) && <section class="disciplines light" aria-labelledby="disc-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="disc-h">{s.home.cover}</h2>
        {showDisciplines && <span class="small">{s.home.choose}</span>}
      </div>
      {home.disciplinesIntro && <p class="disciplines__intro">{home.disciplinesIntro}</p>}
      {showDisciplines && <ul role="list" data-float-list>
        {disciplines.map((d) => (
          <li>
            <a href={L(`/portfolio/?c=${slugify(d.category)}`)} data-float={slugify(d.category)}>
              <span class="display">{d.label}</span>
              <span class="count">{s.count.photos(counts[d.category] ?? 0)}</span>
            </a>
          </li>
        ))}
      </ul>}
    </div>
    {showDisciplines && <div class="float-preview" aria-hidden="true">
      {disciplines.map((d) => (
        <Image src={d.image} alt="" widths={[400, 700]} width={700} sizes="22vw" format="webp" quality={75} loading="lazy" data-key={slugify(d.category)} />
      ))}
    </div>}
  </section>}

  <section class="cta wrap" aria-labelledby="cta-h">
    <h2 id="cta-h" class="display" data-split>{home.ctaTitle}</h2>
    <p>{home.ctaText}</p>
    <div class="cta__actions">
      <a class="btn btn--solid" href={L('/contact/')}>{s.home.book}</a>
      <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </section>
</Base>
