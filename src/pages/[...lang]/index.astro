---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import DeliveryCalc from '../../components/DeliveryCalc.astro';
import ContactSheet from '../../components/ContactSheet.astro';
import StudioProof from '../../components/StudioProof.astro';
import { getSite, getHome, getProjects, getFilms, orientation, slugify, slugOf } from '../../lib/content';
import { langParams, localePath, t, type Lang } from '../../lib/i18n';
import { lqip } from '../../lib/lqip';

export const getStaticPaths = langParams;
const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const L = (p: string) => localePath(lang, p);

const site = await getSite(lang);
const home = await getHome(lang);
const projects = await getProjects(lang);
const films = (await getFilms(lang)).filter((f) => f.data.featured);

const featured = home.featuredProjects
  .map((slug) => projects.find((p) => slugOf(p) === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const counts = Object.fromEntries(
  home.disciplines.map((d) => [d.category, projects.filter((p) => p.data.category === d.category).reduce((n, p) => n + p.data.gallery.length + 1, 0)]),
);
// LCP: a responsive still of the reel paints first; the video itself loads after (see deferHeroVideo in app.ts)
const posterSet = await getImage({ src: home.heroPoster, widths: [480, 800, 1280].filter((w) => w <= home.heroPoster.width), format: 'webp', quality: 70 });
const filmPosters = await Promise.all(films.map((f) => getImage({ src: f.data.poster, width: 1600, format: 'webp', quality: 78 })));
// Blurred previews behind photos that load later (lib/lqip.ts)
const heroPlaceholder = await lqip(home.heroPoster);
const rosPlaceholders = await Promise.all(home.runOfShow.map((r) => lqip(r.image)));
const filmPlaceholders = await Promise.all(films.map((f) => lqip(f.data.poster)));
const bg = (p?: { image: string; color: string }) => p && `background:${p.color} ${p.image} center/cover`;
---

<Base page="home" lang={lang}>
  <link slot="head" rel="preload" as="image" type="image/webp" imagesrcset={posterSet.srcSet.attribute} imagesizes="100vw" fetchpriority="high" />
  <!-- Opening sequence: covers the hero until the shutter opens -->
  <div class="intro" aria-hidden="true">
    <div class="intro__bars"><i></i><i></i></div>
    <span class="intro__line"></span>
    <span class="intro__count">00:00:00:00</span>
  </div>

  <section class="hero" data-hero aria-labelledby="hero-title">
    <div class="hero__media" data-lqip={heroPlaceholder ? 'eager' : undefined} style={heroPlaceholder?.style}>
      <img src={posterSet.src} srcset={posterSet.srcSet.attribute} sizes="100vw" alt={home.heroPosterAlt} fetchpriority="high" decoding="async" class="hero__poster" data-hero-still />
      <video data-hero-video muted loop playsinline preload="none" aria-hidden="true" data-src={home.heroVideo}></video>
    </div>
    <div class="hero__shutter" data-home-shutter aria-hidden="true"></div>
    <!-- Viewfinder HUD (decorative): frame brackets, a focus point that follows the pointer, live exposure -->
    <div class="vf" aria-hidden="true" data-vf>
      <i class="vf__c vf__c--tl"></i><i class="vf__c vf__c--tr"></i><i class="vf__c vf__c--bl"></i><i class="vf__c vf__c--br"></i>
      <div class="vf__focus" data-vf-focus><i></i><i></i><i></i><i></i></div>
      <div class="vf__readout tnum">
        <span data-vf-iso>ISO 3200</span>
        <span data-vf-ap>ƒ/2.8</span>
        <span data-vf-sh>1/250</span>
        <span class="vf__ev" data-vf-ev><b></b><b></b><b></b><b></b><b class="is-on"></b><b></b><b></b><b></b><b></b></span>
      </div>
    </div>
    <div class="hero__text" data-hero-text>
      <h1 class="hero__name display" id="hero-title">
        <span class="line"><span class="w">{site.firstName}</span></span>
        <span class="line"><span class="w">{site.lastName}</span></span>
      </h1>
      <div class="hero__row">
        <p class="hero__lede" data-hero-rise>{s.home.lede}</p>
        <div class="hero__actions" data-hero-rise>
          <a class="btn btn--solid" href="#delivery">{s.home.checkDate}</a>
          <a class="line-link" href={L('/portfolio/')}>{s.home.seeWork}</a>
        </div>
      </div>
      <div class="hero__meta" data-hero-rise>
        <span>{site.location}</span>
        <span class="hero__tc" data-timecode aria-hidden="true">00:00:00:00</span>
      </div>
    </div>
  </section>

  <ContactSheet lang={lang} />

  <section class="howi wrap" id="delivery" aria-labelledby="howi-h">
    <div class="howi__text" data-reveal>
      <h2 id="howi-h" class="display howi__title">{home.statementTitle}</h2>
      <p class="howi__statement">{home.statement}</p>
      <a class="line-link small" href={L('/about/')}>{s.home.howBooking}</a>
    </div>
    <div class="howi__calc" data-reveal>
      <DeliveryCalc lang={lang} previewTime={site.delivery.previewTime} galleryDays={site.delivery.galleryDays} filmDays={site.delivery.filmDays} id="home-calc" />
    </div>
  </section>

  {home.runOfShow.length > 0 && (
    <section class="ros" aria-labelledby="ros-h" data-ros>
      <div class="wrap ros__head" data-reveal>
        <h2 id="ros-h" class="display ros__title">{home.runOfShowTitle}</h2>
      </div>
      <div class="ros__body wrap">
        <figure class="ros__media" aria-hidden="true">
          <div class="ros__pictures" data-lqip={rosPlaceholders[0] ? 'eager' : undefined} style={rosPlaceholders[0]?.style}>
            {home.runOfShow.map((r, i) => (
              <Image src={r.image} alt="" widths={[640, 1000, 1400]} width={1400} sizes="(max-width: 800px) 100vw, 55vw" format="webp" quality={78} loading="lazy" class:list={[i === 0 && 'is-on']} />
            ))}
          </div>
          <figcaption class="ros__clock tnum" data-ros-clock>{home.runOfShow[0].time}</figcaption>
        </figure>
        <ol class="ros__list" role="list">
          {home.runOfShow.map((r, i) => (
            <li class="ros__item" data-ros-item data-time={r.time}>
              <time class="ros__time tnum">{r.time}</time>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
              <Image src={r.image} alt={r.alt} widths={[640, 1000]} width={1000} sizes="100vw" format="webp" quality={76} loading="lazy" class="ros__inline" style={bg(rosPlaceholders[i])} />
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <div class="marquee" data-marquee aria-hidden="true">
    <div class="marquee__track" data-marquee-track>
      {[0, 1].map(() => (
        <div class="marquee__set">
          {home.disciplines.map((d, i) => (
            <span class:list={['marquee__word display', i % 2 === 1 && 'is-outline']}>{d.label}<i>✦</i></span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <section class="spreads wrap" aria-labelledby="sel-h">
    <div class="section-head">
      <h2 id="sel-h">{s.home.selected}</h2>
      <a class="line-link small" href={L('/portfolio/')}>{s.home.fullPortfolio}</a>
    </div>
    {featured.map((p) => {
      const land = orientation(p.data.cover) === 'landscape';
      const slug = slugOf(p);
      return (
        <article class="spread" data-preview>
          <div class:list={['spread__frame', land && 'spread__frame--land']} transition:name={`cover-${slug}`} data-cursor={s.cursor.view}>
            <Frame src={p.data.cover} alt={p.data.coverAlt} parallax sizes="(max-width: 760px) 100vw, 60vw">
              {p.data.coverVideo && <video muted loop playsinline preload="none" data-src={p.data.coverVideo} aria-hidden="true"></video>}
            </Frame>
          </div>
          <div class="spread__text">
            <h3 class:list={['spread__title display', p.data.title.length > 14 && 'spread__title--long']} data-split>{p.data.title}</h3>
            <div class="spread__meta tnum"><span>{s.categories[p.data.category]}</span><span>{p.data.location}</span><span>{p.data.year}</span></div>
            <p class="spread__excerpt">{p.data.excerpt}</p>
          </div>
          <a class="spread__link" href={L(`/work/${slug}/`)} data-cursor={s.cursor.view} aria-label={s.work.view(p.data.title)}></a>
        </article>
      );
    })}
  </section>

  <StudioProof lang={lang} home={home} />

  {films.length > 0 && (
    <section class="strip" data-strip aria-labelledby="films-h">
      <div class="section-head wrap">
        <h2 id="films-h">{s.home.filmsHead}</h2>
        <a class="line-link small" href={L('/films/')}>{s.home.allFilms}</a>
      </div>
      <div class="strip__viewport">
        <div class="strip__track">
          {films.map((f, i) => (
            <article class="strip__item" data-preview>
              <button class="frame-btn" data-film data-title={f.data.title} data-src={f.data.videoFile} data-url={f.data.videoUrl} data-poster={filmPosters[i].src} data-cursor={s.cursor.play} data-cursor-mode="play">
                <span class="sr-only">{s.a11y.play(f.data.title)}</span>
                <div class="frame" data-lqip={filmPlaceholders[i] ? '' : undefined} style={filmPlaceholders[i]?.style}>
                  <Image src={f.data.poster} alt={f.data.posterAlt} widths={[640, 1000, 1400]} width={1400} sizes="(max-width: 900px) 82vw, 46vw" format="webp" quality={78} loading="lazy" />
                  {f.data.previewFile && <video muted loop playsinline preload="none" data-src={f.data.previewFile} aria-hidden="true"></video>}
                </div>
                <div class="strip__caption">
                  <h3>{f.data.title}</h3>
                  <span>{s.kinds[f.data.kind]}, {f.data.duration}</span>
                </div>
              </button>
            </article>
          ))}
          <div class="strip__end"><a class="btn" href={L('/films/')}>{s.home.everyFilm}</a></div>
        </div>
      </div>
    </section>
  )}

  <section class="disciplines light" aria-labelledby="disc-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="disc-h">{s.home.cover}</h2>
        <span class="small">{s.home.choose}</span>
      </div>
      <ul role="list" data-float-list>
        {home.disciplines.map((d) => (
          <li>
            <a href={L(`/portfolio/?c=${slugify(d.category)}`)} data-float={slugify(d.category)}>
              <span class="display">{d.label}</span>
              <span class="count">{s.count.photos(counts[d.category] ?? 0)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="float-preview" aria-hidden="true">
      {home.disciplines.map((d) => (
        <Image src={d.image} alt="" widths={[400, 700]} width={700} sizes="22vw" format="webp" quality={75} loading="lazy" data-key={slugify(d.category)} />
      ))}
    </div>
  </section>

  <section class="cta wrap" aria-labelledby="cta-h">
    <h2 id="cta-h" class="display" data-split>{home.ctaTitle}</h2>
    <p>{home.ctaText}</p>
    <div class="cta__actions">
      <a class="btn btn--solid" href={L('/contact/')}>{s.home.book}</a>
      <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </section>
</Base>
