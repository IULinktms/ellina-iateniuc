---
import Base from '../../layouts/Base.astro';
import BookingForm from '../../components/BookingForm.astro';
import DirectContact from '../../components/DirectContact.astro';
import { getBooking, getSite, hasRealContent } from '../../lib/content';
import { langParams, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langParams;
const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const c = s.contact;
const booking = await getBooking(lang);
const site = await getSite(lang);
---

<Base page="contact" lang={lang} title={booking.title} description={booking.intro}>
  <header class="page-head">
    <h1 class="display">
      {c.head.map((l) => <span class="line" data-split="now">{l}</span>)}
    </h1>
    <div class="page-head__row"><p>{booking.intro}</p></div>
  </header>

  <section class="contact grid12">
    <aside class="contact__aside" aria-labelledby="sessions-h">
      <h2 id="sessions-h" class="small muted" style="font-weight:500;margin-bottom:1rem">{c.services}</h2>
      <div class="sessions">
        {booking.sessions.map((x) => (
          <div class="session">
            <h3>{x.name}</h3>
            <p>{x.includes}</p>
            <div class="meta"><span>{x.duration}</span><span>{hasRealContent(x.price) ? x.price : s.bookingUi.onRequest}</span></div>
          </div>
        ))}
      </div>
      <div class="direct">
        <span class="small muted">{c.direct}</span>
        <a class="line-link" href={`mailto:${site.email}`}>{site.email}</a>
        <DirectContact lang={lang} site={site} />
        <span class="small" style="margin-top:.75rem">
          {site.socials.filter((x) => x.label !== 'Telegram').map((x, i) => <>{i > 0 && ', '}<a class="line-link" href={x.url} target="_blank" rel="me noopener">{x.label}</a></>)}
        </span>
      </div>
    </aside>

    <div class="contact__form">
      <BookingForm lang={lang} booking={booking} site={site} />
    </div>
  </section>
</Base>
