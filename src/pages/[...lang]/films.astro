---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import { FILM_KINDS } from '../../content.config';
import { getFilms, getProjects, slugify, slugOf } from '../../lib/content';
import { langParams, localePath, t, type Lang } from '../../lib/i18n';
import { videoLd } from '../../lib/seo';

export const getStaticPaths = langParams;
const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const films = await getFilms(lang);
const projects = await getProjects(lang);
// Vertical 9:16 Reels never take the 21:9 feature slot; they get their own shelf in the grid
const isVertical = (f: (typeof films)[number]) => f.data.aspectRatio === 'portrait';
const feature = films.find((f) => !isVertical(f));
const rest = films.filter((f) => f !== feature);
const wide = rest.filter((f) => !isVertical(f));
const vertical = rest.filter(isVertical);
const posters = Object.fromEntries(
  await Promise.all(films.map(async (f) => [f.id, (await getImage({ src: f.data.poster, width: 1920, format: 'webp', quality: 80 })).src])),
);
const kinds = FILM_KINDS.filter((k) => rest.some((f) => f.data.kind === k));
const projectFor = (slug?: string) => projects.find((p) => slugOf(p) === slug);
const ld = films.map((f) => videoLd(f, lang, Astro.site!, posters[f.id]));
---

<Base page="films" lang={lang} title={s.films.seoTitle} description={s.films.desc} jsonLd={ld}>
  <header class="page-head">
    <h1 class="display"><span class="line" data-split="now">{s.films.title}</span></h1>
    <div class="page-head__row">
      <p>{s.films.intro}</p>
      {kinds.length > 1 && (
        <div class="filters" role="group" aria-label={s.films.filter} data-filters="#films">
          <button class="filter" data-filter="all" aria-pressed="true">{s.films.all}</button>
          {kinds.map((k) => <button class="filter" data-filter={slugify(k)} aria-pressed="false">{s.kinds[k]}</button>)}
        </div>
      )}
    </div>
  </header>

  {feature && (
    <section class="feature-film" aria-label={s.films.featured} data-preview>
      <button data-film data-aspect="landscape" data-title={feature.data.title} data-src={feature.data.videoFile} data-url={feature.data.videoUrl} data-poster={posters[feature.id]} data-cursor={s.cursor.play} data-cursor-mode="play">
        <span class="sr-only">{s.a11y.play(feature.data.title)}</span>
        <Frame src={feature.data.poster} alt={feature.data.posterAlt} parallax eager sizes="100vw">
          {feature.data.previewFile && <video muted loop playsinline preload="none" data-src={feature.data.previewFile} aria-hidden="true" style="position:absolute;inset:0;opacity:0;transition:opacity .6s"></video>}
        </Frame>
        <div class="feature-film__cap">
          <div>
            <h2 class="display">{feature.data.title}</h2>
            <p class="muted" style="margin-top:.6rem;max-width:34rem">{feature.data.excerpt}</p>
          </div>
          <span class="small muted tnum">{s.kinds[feature.data.kind]}, {feature.data.year}, {feature.data.duration}</span>
        </div>
      </button>
      {/* The film's own story is one tap away, as on the cards below (a link can't sit inside the play button) */}
      {projectFor(feature.data.project) && <a class="line-link feature-film__more" href={localePath(lang, `/work/${slugOf(projectFor(feature.data.project)!)}/`)}>{s.films.photos}</a>}
    </section>
  )}

  {/* With only the featured film there is nothing to list */}
  {rest.length > 0 && <section class="film-grid" id="films" aria-label={s.films.list}>
    {vertical.length > 0 && (
      <div class="reel-shelf">
        {vertical.map((f) => {
          const proj = projectFor(f.data.project);
          return (
            <article class="film-card film-card--vertical" data-cat={slugify(f.data.kind)} data-preview>
              <button data-film data-aspect="portrait" data-title={f.data.title} data-src={f.data.videoFile} data-url={f.data.videoUrl} data-poster={posters[f.id]} data-cursor={s.cursor.play} data-cursor-mode="play" aria-label={s.a11y.play(f.data.title)}>
                <Frame src={f.data.poster} alt={f.data.posterAlt} sizes="(max-width: 760px) 62vw, 24vw" widths={[480, 800]}>
                  {f.data.previewFile && <video muted loop playsinline preload="none" data-src={f.data.previewFile} aria-hidden="true"></video>}
                </Frame>
              </button>
              <h3>{f.data.title}</h3>
              <div class="meta">
                <span>{s.kinds[f.data.kind]}</span>{f.data.duration && <span>{f.data.duration}</span>}
                {proj && <a class="line-link" href={localePath(lang, `/work/${slugOf(proj)}/`)}>{s.films.photos}</a>}
              </div>
            </article>
          );
        })}
      </div>
    )}
    {wide.map((f) => {
      const proj = projectFor(f.data.project);
      return (
        <article class="film-card" data-cat={slugify(f.data.kind)} data-preview>
          <button data-film data-aspect="landscape" data-title={f.data.title} data-src={f.data.videoFile} data-url={f.data.videoUrl} data-poster={posters[f.id]} data-cursor={s.cursor.play} data-cursor-mode="play" aria-label={s.a11y.play(f.data.title)}>
            <Frame src={f.data.poster} alt={f.data.posterAlt} sizes="(max-width: 760px) 100vw, 50vw" widths={[640, 1000, 1500]}>
              {f.data.previewFile && <video muted loop playsinline preload="none" data-src={f.data.previewFile} aria-hidden="true"></video>}
            </Frame>
          </button>
          <h3>{f.data.title}</h3>
          <p>{f.data.excerpt}</p>
          <div class="meta">
            <span>{s.kinds[f.data.kind]}</span><span>{f.data.year}</span>{f.data.duration && <span>{f.data.duration}</span>}
            {proj && <a class="line-link" href={localePath(lang, `/work/${slugOf(proj)}/`)}>{s.films.photos}</a>}
          </div>
        </article>
      );
    })}
  </section>}
</Base>

<style>
  .feature-film [data-preview].is-previewing video, .feature-film.is-previewing video { opacity: 1 !important; }
</style>
