---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Frame from '../../../components/Frame.astro';
import { getProjects, getFilms, getSite, fullSize, orientation, slugOf, type Project } from '../../../lib/content';
import { LOCALES, DEFAULT_LANG, HTML_LANG, localePath, t, type Lang } from '../../../lib/i18n';
import { projectLd, videoLd } from '../../../lib/seo';
import { lqip } from '../../../lib/lqip';
import { whatsappHref } from '../../../lib/whatsapp';

export async function getStaticPaths() {
  const out = [];
  for (const lang of LOCALES) {
    const projects = await getProjects(lang);
    out.push(
      ...projects.map((p, i) => ({
        params: { lang: lang === DEFAULT_LANG ? undefined : lang, slug: slugOf(p) },
        props: { lang, project: p, next: projects[(i + 1) % projects.length] },
      })),
    );
  }
  return out;
}
interface Props { lang: Lang; project: Project; next: Project; }
const { lang, project, next } = Astro.props;
const s = t(lang);
const d = project.data;
const slug = slugOf(project);
const nextSlug = slugOf(next);
const whatsapp = whatsappHref((await getSite(lang)).whatsapp, lang);
const { Content } = await render(project);
const films = (await getFilms(lang)).filter((f) => f.data.project === slug);
const gallery = await Promise.all(d.gallery.map(async (g) => ({ ...g, full: await fullSize(g.image) })));
// Frame-strip thumbnails are tiny: the dominant colour is placeholder enough
const thumbColors = await Promise.all(gallery.map(async (g) => (await lqip(g.image))?.color));
const filmPosters = await Promise.all(films.map((f) => getImage({ src: f.data.poster, width: 1600, format: 'webp' })));

const sizesFor: Record<string, string> = {
  full: '100vw',
  wide: '(max-width: 760px) 100vw, 84vw',
  half: '(max-width: 760px) 100vw, 50vw',
  'inset-left': '(max-width: 760px) 100vw, 42vw',
  'inset-right': '(max-width: 760px) 100vw, 42vw',
};
const pageUrl = new URL(localePath(lang, `/work/${slug}/`), Astro.site).toString();
const ld = [
  ...projectLd(project, lang, pageUrl, Astro.site!, [{ src: (await getImage({ src: d.cover, width: 1600, format: 'webp' })).src, alt: d.coverAlt }, ...gallery.map((g) => ({ src: g.full, alt: g.alt, caption: g.caption }))]),
  ...films.map((f, i) => videoLd(f, lang, Astro.site!, filmPosters[i].src)),
];
const titleWords = d.title.split(' ');
const half = Math.ceil(titleWords.length / 2);
const titleLines = titleWords.length > 2 ? [titleWords.slice(0, half).join(' '), titleWords.slice(half).join(' ')] : [d.title];
---

<Base page="work" lang={lang} title={d.title} description={d.seoDescription ?? d.excerpt} image={d.cover} imageAlt={d.coverAlt} type="article" jsonLd={ld}>
  <section class:list={['p-hero', orientation(d.cover) === 'portrait' && 'p-hero--portrait']} data-hero>
    <div class="p-hero__media" transition:name={`cover-${slug}`}>
      <Frame src={d.cover} alt={d.coverAlt} eager aperture={false} sizes="100vw">
        {d.coverVideo && <video autoplay muted loop playsinline preload="metadata" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"><source src={d.coverVideo} type="video/mp4" /></video>}
      </Frame>
    </div>
    <div class="p-hero__text" data-hero-text>
      <h1 class="display" data-split="now">{d.title}</h1>
      {d.subtitle && <p class="p-hero__sub">{d.subtitle}</p>}
    </div>
  </section>

  <dl class="p-facts">
    {/* Same order as the spread and portfolio facts: category, place, year; the client closes the row */}
    <div><dt>{s.work.category}</dt><dd>{s.categories[d.category]}</dd></div>
    {d.location && <div><dt>{s.work.location}</dt><dd>{d.location}</dd></div>}
    <div><dt>{s.work.year}</dt><dd class="tnum">{d.year}</dd></div>
    {d.client && <div><dt>{s.work.client}</dt><dd>{d.client}</dd></div>}
  </dl>

  <section class="p-story wrap grid12">
    <p class="lede" data-split>{d.excerpt}</p>
    <div class="prose"><Content /></div>
  </section>

  <div class="story-gallery" data-story-gallery>
    <nav class="story-frames" aria-label={s.studio.frames}>
      {gallery.map((g, i) => <a href={`#frame-${i + 1}`} data-frame-link aria-label={`${s.studio.frame} ${i + 1}: ${g.caption || g.alt}`}>
        <Image src={g.image} alt="" width={140} format="webp" quality={60} loading="lazy" style={thumbColors[i] && `background:${thumbColors[i]}`} />
        <span class="tnum">{String(i + 1).padStart(2, '0')}</span>
      </a>)}
    </nav>
    <div class="story-progress" aria-hidden="true"><i data-story-progress></i></div>
  <section class="p-gallery" aria-label={s.work.photos(d.title)}>
    {gallery.map((g, i) => (
      <figure class={`g-${g.layout}`} id={`frame-${i + 1}`} data-story-frame>
        <button data-lb-item data-full={g.full} data-alt={g.alt} data-caption={`${s.studio.frame} ${String(i + 1).padStart(2, '0')} · ${d.year} · ${g.caption || g.alt}`} data-cursor={s.cursor.expand} aria-label={s.a11y.open(g.alt)}>
          <Frame src={g.image} alt={g.alt} parallax={g.layout === 'full' || g.layout === 'wide'} sizes={sizesFor[g.layout]} style={g.layout === 'full' ? 'aspect-ratio:16/9' : `aspect-ratio:${g.image.width}/${g.image.height}`} />
        </button>
        {g.caption && <figcaption>{g.caption}</figcaption>}
      </figure>
    ))}
  </section>

  </div>

  {films.length > 0 && (
    <section class="wrap" style="padding-bottom: var(--section)" aria-label={s.work.filmAria}>
      <div class="section-head"><h2>{s.work.film}</h2></div>
      {films.map((f, i) => (
        <div class:list={['film-card', f.data.aspectRatio === 'portrait' && 'film-card--vertical']} data-preview>
          <button data-film data-aspect={f.data.aspectRatio} data-title={f.data.title} data-src={f.data.videoFile} data-url={f.data.videoUrl} data-poster={filmPosters[i].src} data-cursor={s.cursor.play} data-cursor-mode="play" aria-label={s.a11y.play(f.data.title)}>
            <Frame src={f.data.poster} alt={f.data.posterAlt} sizes={f.data.aspectRatio === 'portrait' ? '(max-width: 760px) 80vw, 24rem' : '100vw'} style={f.data.aspectRatio === 'portrait' ? 'aspect-ratio:9/16' : 'aspect-ratio:21/9'}>
              {f.data.previewFile && <video muted loop playsinline preload="none" data-src={f.data.previewFile} aria-hidden="true"></video>}
            </Frame>
          </button>
          <h3>{f.data.title}</h3>
          <p>{f.data.excerpt}</p>
        </div>
      ))}
    </section>
  )}

  {d.credits.length > 0 && (
    <section class="p-credits" aria-labelledby="credits-h">
      <h2 id="credits-h">{s.work.credits}</h2>
      <dl>
        {d.credits.map((c) => <div><dt>{c.role}</dt><dd>{c.name}</dd></div>)}
      </dl>
    </section>
  )}

  <section class="story-booking wrap">
    <h2 class="display">{s.studio.bookStory}</h2>
    <a class="btn btn--solid" href={whatsapp || localePath(lang, '/contact/')}>{whatsapp ? s.bookingUi.waCta : s.studio.book}</a>
  </section>
  {nextSlug !== slug && (
    <section class="story-next" data-next-story>
      <div class="story-next__controls wrap">
        <button class="line-link" data-next-arm aria-pressed="false">{s.studio.advance}</button>
        <p class="small muted" id="advance-hint">{s.studio.advanceHint}</p>
      </div>
    <a class="next" data-next-link href={localePath(lang, `/work/${nextSlug}/`)} data-cursor={s.cursor.next}>
      <div class="next__media" transition:name={`cover-${nextSlug}`}>
        <Frame src={next.data.cover} alt="" aperture={false} sizes="100vw" widths={[800, 1200, 1600]} />
      </div>
      <i class="story-next__fill" data-next-fill aria-hidden="true"></i>
      <div class="next__text">
        <span>{s.work.next}</span>
        <h2 class="display">{next.data.title}</h2>
      </div>
    </a>
    </section>
  )}
</Base>
