---
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import { CATEGORIES } from '../../content.config';
import { getProjects, projectPhotos, fullSize, slugify, slugOf } from '../../lib/content';
import { langParams, localePath, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langParams;
const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const projects = await getProjects(lang);

// Every portfolio photograph: each project's cover plus its gallery images
const photos = await Promise.all(
  projects
    .flatMap((p) => projectPhotos(p).map((ph) => ({ ...ph, p })))
    .map(async (ph) => ({ ...ph, full: await fullSize(ph.src) })),
);
// Interleave projects so the "All" view doesn't read as blocks
const byProject = projects.map((p) => photos.filter((ph) => ph.p.id === p.id));
const mixed: typeof photos = [];
for (let i = 0; byProject.some((b) => b[i]); i++) byProject.forEach((b) => b[i] && mixed.push(b[i]));

const counts = Object.fromEntries(CATEGORIES.map((c) => [c, photos.filter((ph) => ph.p.data.category === c).length]));
const cats = CATEGORIES.filter((c) => counts[c] > 0);
const url = (p: (typeof projects)[number]) => localePath(lang, `/work/${slugOf(p)}/`);
// One project is a story, not an index: it opens the page as an editorial lead, its frames carry their own
// captions instead of the same title ten times, and the one-row project list at the end goes away
const single = projects.length === 1 ? projects[0] : undefined;
---

<Base page="portfolio" lang={lang} title={s.portfolio.title} description={s.portfolio.desc}>
  <header class="page-head">
    <h1 class="display" data-split="now">{s.portfolio.title}</h1>
    <div class="page-head__row">
      {/* With one event, "N photographs from 1 event" and a one-category filter say nothing */}
      <p>{projects.length > 1 ? s.portfolio.intro(photos.length, projects.length) : s.portfolio.introOne}</p>
      {cats.length > 1 && (
        <div class="filters" role="group" aria-label={s.portfolio.filter} data-filters="#gallery">
          <button class="filter" data-filter="all" aria-pressed="true">{s.portfolio.all}<sup>{photos.length}</sup></button>
          {cats.map((c) => <button class="filter" data-filter={slugify(c)} aria-pressed="false">{s.categories[c]}<sup>{counts[c]}</sup></button>)}
        </div>
      )}
    </div>
  </header>

  {single && (
    <section class="port-lead wrap" aria-labelledby="lead-h">
      <p class="port-lead__meta tnum"><span>{s.categories[single.data.category]}</span>{single.data.location && <span>{single.data.location}</span>}<span>{single.data.year}</span>{single.data.client && <span>{single.data.client}</span>}</p>
      <h2 id="lead-h" class="port-lead__title"><a href={url(single)} aria-label={s.work.view(single.data.title)}>{single.data.title}<span aria-hidden="true"> ↗</span></a></h2>
      <p class="port-lead__text">{single.data.excerpt}</p>
    </section>
  )}

  <section class:list={['masonry', single && 'masonry--story']} id="gallery" aria-label={s.portfolio.photos}>
    {mixed.map((ph, i) => (
      <figure class="masonry__item" data-cat={slugify(ph.p.data.category)}>
        <button
          data-lb-item
          data-full={ph.full}
          data-alt={ph.alt}
          data-caption={ph.caption}
          data-project={ph.p.data.title}
          data-project-url={url(ph.p)}
          data-cursor={s.cursor.expand}
        >
          <span class="sr-only">{s.a11y.open(ph.alt)}</span>
          {/* One-project layout: the first photo sits in the first screen on phones and is the LCP, so it loads at once */}
          <Frame src={ph.src} alt="" eager={single && i === 0} sizes={single ? '(max-width: 560px) 100vw, (max-width: 1800px) 50vw, 45rem' : '(max-width: 560px) 100vw, (max-width: 1000px) 50vw, 33vw'} widths={single ? [480, 800, 1200, 1600] : [480, 800, 1200]} style={`aspect-ratio:${ph.src.width}/${ph.src.height}`} />
          {!single && <figcaption><span>{ph.p.data.title}</span><span>{s.categories[ph.p.data.category]}</span></figcaption>}
        </button>
      </figure>
    ))}
  </section>

  {!single && <section class="wrap" style="padding-bottom: var(--section)" aria-labelledby="proj-h">
    <div class="section-head"><h2 id="proj-h">{s.portfolio.projects}</h2></div>
    <ul role="list" class="proj-list">
      {projects.map((p) => (
        <li>
          <a href={url(p)} class="proj-row">
            <span class="display">{p.data.title}</span>
            {/* Same facts, same order as the home spread: category, place, year */}
            <span class="proj-row__meta muted small tnum"><span>{s.categories[p.data.category]}</span>{p.data.location && <span>{p.data.location}</span>}<span>{p.data.year}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>}
</Base>

<style>
  .proj-list > li, .proj-row, .proj-row > span { min-width: 0; }
  .proj-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-block: 0.6rem; transition: transform 400ms var(--ease-out), opacity 240ms ease; }
  .proj-row .display { font-size: var(--t-xl); }
  @media (max-width: 760px) {
    .proj-row { flex-direction: column; align-items: flex-start; gap: .35rem; }
    .proj-row .display { font-size: clamp(2rem, 9vw, 3rem); overflow-wrap: anywhere; }
  }
  @media (hover: hover) and (pointer: fine) {
    .proj-list:hover .proj-row { opacity: 0.35; }
    .proj-list:hover .proj-row:hover { opacity: 1; transform: translateX(1.25rem); }
  }
</style>
