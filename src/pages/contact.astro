---
import Base from '../layouts/Base.astro';
import { getBooking, getSite } from '../lib/content';

const booking = await getBooking();
const site = await getSite();
const isPreview = import.meta.env.PUBLIC_PREVIEW_LITE === '1';
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const types = [...booking.sessions.map((s) => s.name), 'Something else'];
---

<Base page="contact" title={booking.title} description={booking.intro}>
  <header class="page-head">
    <h1 class="display">
      <span class="line" data-split="now">Book your</span>
      <span class="line" data-split="now">event</span>
    </h1>
    <div class="page-head__row"><p>{booking.intro}</p></div>
  </header>

  <section class="contact grid12">
    <aside class="contact__aside" aria-labelledby="sessions-h">
      <h2 id="sessions-h" class="small muted" style="font-weight:500;margin-bottom:1rem">Services</h2>
      <div class="sessions">
        {booking.sessions.map((s) => (
          <div class="session">
            <h3>{s.name}</h3>
            <p>{s.includes}</p>
            <div class="meta"><span>{s.duration}</span>{s.price && <span>{s.price}</span>}</div>
          </div>
        ))}
      </div>
      <div class="direct">
        <span class="small muted">Prefer to write directly?</span>
        <a class="line-link" href={`mailto:${site.email}`}>{site.email}</a>
        {site.phone && <a class="line-link" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>}
        <span class="small" style="margin-top:.75rem">
          {site.socials.map((s, i) => <>{i > 0 && ', '}<a class="line-link" href={s.url} target="_blank" rel="me noopener">{s.label}</a></>)}
        </span>
      </div>
    </aside>

    <div class="contact__form">
      <form action="/api/contact" method="post" data-contact novalidate data-preview={isPreview ? '' : undefined}>
        <div class="field-row">
          <div class="field">
            <label for="f-name">Your name</label>
            <input id="f-name" name="name" autocomplete="name" required maxlength="120" />
            <span class="err" aria-live="polite"></span>
          </div>
          <div class="field">
            <label for="f-email">Email</label>
            <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="200" />
            <span class="err" aria-live="polite"></span>
          </div>
        </div>

        <fieldset class="field" style="border-left:0;border-right:0;border-top:0;margin:0;padding-inline:0">
          <legend class="xsmall muted" style="padding:0">What kind of event?</legend>
          <div class="chips">
            {types.map((t, i) => (
              <>
                <input type="radio" name="type" id={`t-${i}`} value={t} checked={i === 0} />
                <label for={`t-${i}`}>{t}</label>
              </>
            ))}
          </div>
        </fieldset>

        <div class="field-row">
          <div class="field">
            <label for="f-org">Company or event name (optional)</label>
            <input id="f-org" name="organisation" autocomplete="organization" maxlength="160" />
            <span class="err"></span>
          </div>
          <div class="field">
            <label for="f-guests">Expected guests (optional)</label>
            <input id="f-guests" name="guests" inputmode="numeric" placeholder="e.g. 150" maxlength="20" />
            <span class="err"></span>
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="f-date">Event date</label>
            <input id="f-date" name="date" type="date" />
            <span class="err"></span>
          </div>
          <div class="field">
            <label for="f-loc">Location (optional)</label>
            <input id="f-loc" name="location" placeholder="Venue or city" maxlength="160" />
            <span class="err"></span>
          </div>
        </div>

        <div class="field">
          <label for="f-msg">Tell me about it</label>
          <textarea id="f-msg" name="message" required maxlength="5000" placeholder="Programme, hours of coverage, and what the photos are for: press, social media, next year’s promotion."></textarea>
          <span class="err" aria-live="polite"></span>
        </div>

        <!-- Spam protection: hidden honeypot field + time-to-fill check (+ Turnstile if configured) -->
        <div class="hp" aria-hidden="true">
          <label for="f-website">Website</label>
          <input id="f-website" name="website_url" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="_t" value="" />
        {turnstileKey && (
          <>
            <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="dark" style="margin-top:1.5rem"></div>
            <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
          </>
        )}

        <div class="form-foot">
          <p class="form-status" data-status role="status" aria-live="polite">{site.responseTime}</p>
          <button class="btn btn--solid" type="submit">Check availability</button>
        </div>
      </form>

      <div class="form-done" data-form-done hidden tabindex="-1">
        <p>{booking.successMessage}</p>
      </div>
    </div>
  </section>
</Base>
